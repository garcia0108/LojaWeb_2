@model IEnumerable<LojaWeb_2.Models.Combo>

@{
    ViewData["Title"] = "Combos";
}

<div class="container mt-4">

    <!-- CABEÇALHO -->

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Combos Especiais
        </h1>

        <p class="text-muted">
            Aproveite nossos combos e economize ainda mais.
        </p>

    </div>


    <!-- COMBOS -->
    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var combo in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <div class="card h-100 shadow-sm border-0 combo-card">

                        <!-- IMAGEM -->

                        <div class="position-relative">

                            @if (!string.IsNullOrEmpty(combo.Imagem))
                            {
                                <img src="@combo.Imagem"
                                     class="card-img-top combo-imagem"
                                     alt="@combo.Nome" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light combo-imagem">

                                    <i class="bi bi-box-seam fs-1 text-muted"></i>

                                </div>
                            }


                            <!-- BADGES DO COMBO -->
                            <div class="position-absolute top-0 end-0 m-2 d-flex flex-column align-items-end gap-1">

                                @if (combo.PercentualDesconto > 0)
                                {
                                    <span class="badge bg-danger">

                                        @combo.PercentualDesconto.ToString("0")% OFF

                                    </span>
                                }

                                @if (combo.FreteGratis)
                                {
                                    <span class="badge bg-success">

                                        
                                        Frete grátis

                                    </span>
                                }

                            </div>

                        </div>


                        <!-- INFORMAÇÕES -->

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @combo.Nome
                            </h5>


                            @if (!string.IsNullOrEmpty(combo.Descricao))
                            {
                                <p class="text-muted small">
                                    @combo.Descricao
                                </p>
                            }


                        <!-- QUANTIDADE -->

                        <div class="mb-3">

                            <span class="badge bg-primary">

                                @combo.Itens.Sum(i => i.Quantidade)
                                @(combo.Itens.Sum(i => i.Quantidade) == 1
                                                            ? " item"
                                                            : " itens")

                        </span>

                            </div>


                            <!-- PRODUTOS -->

                            <div class="small text-muted mb-3">

                        @foreach (var item in combo.Itens.Take(3))
                                {
                                    <div>
                                        • @item.Quantidade x @item.Produto?.Nome
                                    </div>
                                }

                                @if (combo.Itens.Count > 3)
                                {
                                    <div>
                                        • + @(combo.Itens.Count - 3) produtos
                                    </div>
                                }

                            </div>


                            <!-- PREÇO -->

                            <div class="mt-auto">

                                @if (combo.PercentualDesconto > 0)
                                {
                                    <div class="text-muted text-decoration-line-through small">

                                        De @combo.ValorOriginal.ToString("C")

                                    </div>
                                }

                                <span class="text-muted small">
                                    Por apenas
                                </span>

                                <h4 class="fw-bold text-success mb-3">

                                    @combo.Preco.ToString("C")

                                </h4>


                                <a asp-action="DetalhesCombo"
                                   asp-route-id="@combo.Id"
                                   class="btn btn-primary w-100">

                                    <i class="bi bi-eye"></i>
                                    Ver Combo

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-box-seam fs-1 text-muted"></i>

            <h4 class="mt-3">
                Nenhum combo disponível
            </h4>

            <p class="text-muted">
                No momento não temos combos disponíveis.
            </p>

        </div>
    }

</div>


<style>

    .combo-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        overflow: hidden;
    }

        .combo-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12) !important;
        }

    .combo-imagem {
        height: 280px;
        width: 100%;
        object-fit: contain;
        background-color: #f8f9fa;
        transition: transform 0.3s ease;
    }

    .combo-card:hover .combo-imagem {
        transform: scale(1.04);
    }

</style>