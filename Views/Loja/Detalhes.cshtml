// =========================================================
// ATUALIZAÇÃO DINÂMICA DO AVATAR AO MUDAR FORMULÁRIO
// =========================================================

function atualizarAvatarDinamicamente() {

    // Apenas atualiza se o modelo já foi carregado
    if (!window.avatar3DPronto) {
        return;
    }

    const altura = parseFloat(alturaProvador?.value || 0);
    const peso = parseFloat(pesoProvador?.value || 0);

    if (!altura || !peso) {
        return;
    }

    // Atualiza o objeto de dados globais
    window.dadosProvador = window.dadosProvador || {};
    window.dadosProvador.altura = altura;
    window.dadosProvador.peso = peso;

    // Calcula volume corporal (peso) e atualiza avatar
    if (typeof window.calcularVolumeCorporal === 'function' &&
        typeof window.atualizarPesoAvatar3D === 'function') {

        const intensidadeCorporal = window.calcularVolumeCorporal(altura, peso);
        window.atualizarPesoAvatar3D(intensidadeCorporal);

        console.log('Avatar atualizado dinamicamente - Vol corporal:', intensidadeCorporal);
    }

    // Atualiza a barriga
    if (typeof window.atualizarBarriga3D === 'function') {

        const intensidadeBarriga = Math.max(
            0,
            Math.min(0.90, (peso - 70) / 100)
        );

        window.atualizarBarriga3D(intensidadeBarriga);

        console.log('Barriga atualizada - Intensidade:', intensidadeBarriga);
    }
}

// Detectar mudanças em tempo real nos inputs
if (alturaProvador) {
    alturaProvador.addEventListener('input', atualizarAvatarDinamicamente);
}

if (pesoProvador) {
    pesoProvador.addEventListener('input', atualizarAvatarDinamicamente);
}

