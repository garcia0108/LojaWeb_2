    }

    .produto-titulo {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 12px;
    }

    .produto-cor-titulo {
    margin-top: 4px;
    margin-bottom: 12px;
    font-size: 1rem;
    color: #666;
}

