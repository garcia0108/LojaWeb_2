if (btnToraxMenos) {

    btnToraxMenos.addEventListener(
        'click',
        function () {

            if (toraxPosicao > 0) {

                toraxPosicao--;

                atualizarTorax();

            }

        }
    );

}


// ---------------------------------------------------------
// BOTÃO MAIS
// ---------------------------------------------------------

if (btnToraxMais) {

    btnToraxMais.addEventListener(
        'click',
        function () {

            if (
                toraxPosicao <
                toraxTotalPosicoes - 1
            ) {

                toraxPosicao++;

                atualizarTorax();

            }

        }
    );

}


// ---------------------------------------------------------
// CLIQUE NA RÉGUA
// ---------------------------------------------------------

if (reguaTorax) {

    reguaTorax.addEventListener(
        'click',
        function (evento) {

            // Não processa se clicou diretamente na bolinha
            if (
                evento.target === indicadorTorax
            ) {
                return;
            }


            const rect =
                reguaTorax.getBoundingClientRect();


            const posicaoX =
                evento.clientX - rect.left;


            let percentual =
                posicaoX / rect.width;


            percentual =
                Math.max(
                    0,
                    Math.min(1, percentual)
                );


            toraxPosicao =
                Math.round(
                    percentual *
                    (toraxTotalPosicoes - 1)
                );


            atualizarTorax();

        }
    );

}


// ---------------------------------------------------------
// ARRASTAR A BOLINHA
// ---------------------------------------------------------

let arrastandoTorax = false;


if (indicadorTorax) {

    indicadorTorax.addEventListener(
        'pointerdown',
        function (evento) {

            arrastandoTorax = true;

            indicadorTorax.setPointerCapture(
                evento.pointerId
            );

            evento.preventDefault();

        }
    );


    indicadorTorax.addEventListener(
        'pointermove',
        function (evento) {

            if (!arrastandoTorax || !reguaTorax) {
                return;
            }


            const rect =
                reguaTorax.getBoundingClientRect();


            let posicaoX =
                evento.clientX - rect.left;


            posicaoX =
                Math.max(
                    0,
                    Math.min(
                        rect.width,
                        posicaoX
                    )
                );


            let percentual =
                posicaoX / rect.width;


            toraxPosicao =
                Math.round(
                    percentual *
                    (toraxTotalPosicoes - 1)
                );


            atualizarTorax();

        }
    );


    indicadorTorax.addEventListener(
        'pointerup',
        function () {

            arrastandoTorax = false;

        }
    );


    indicadorTorax.addEventListener(
        'pointercancel',
        function () {

            arrastandoTorax = false;

        }
    );

}


// ---------------------------------------------------------
// INICIALIZAÇÃO
// ---------------------------------------------------------

atualizarTorax();

