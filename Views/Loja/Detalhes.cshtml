}

.provador-btn-proximo {
    min-width: 110px;
    height: 42px;

    border-radius: 5px;

    font-size: 14px;
    font-weight: 600;
}


/* =========================================================
   RESPONSIVO - PROVADOR VIRTUAL
   ========================================================= */

@@media (max-width: 767px) {

    .modal-provador-dialog {
        width: calc(100% - 20px);
    }

    .provador-layout {
        grid-template-columns: 1fr;
    }

    .provador-imagem {
        min-height: 260px;
        max-height: 300px;
    }

    .provador-produto-img {
        object-fit: contain;
    }

    .provador-conteudo {
        padding: 35px 25px 25px;
    }

    .provador-titulo {
        font-size: 23px;
    }

    .provador-footer {
        margin-top: 10px;
    }
}

/* =========================================
   PASSO 2 - PROVADOR VIRTUAL
   ========================================= */

.provador-passo2 {
    width: 100%;
}

.passo2-cabecalho {
