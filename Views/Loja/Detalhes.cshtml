@model LojaWeb_2.Models.Produto

@{
    ViewData["Title"] = Model.Nome;

    var estoque = ViewBag.Estoque
        as List<LojaWeb_2.Models.Estoque>
        ?? new List<LojaWeb_2.Models.Estoque>();

    var corInicial = ViewBag.CorSelecionada as string;

    var coresComImagens = Model.Cores?
        .Where(c => !string.IsNullOrWhiteSpace(c.Nome))
        .ToList()
        ?? new List<LojaWeb_2.Models.ProdutoCor>();

    var corParaInicializar = coresComImagens
        .FirstOrDefault(c =>
            !string.IsNullOrWhiteSpace(corInicial) &&
            string.Equals(
                c.Nome,
                corInicial,
                StringComparison.OrdinalIgnoreCase));

    if (corParaInicializar == null)
    {
        corParaInicializar = coresComImagens.FirstOrDefault();
    }
}

<style>
    /* =========================================================
           PRODUTO - DETALHES
           ========================================================= */

    .produto-detalhes {
        padding-top: 35px;
        padding-bottom: 70px;
    }

    /* =========================================================
           GALERIA
           ========================================================= */

    .produto-galeria {
        width: 100%;
    }

    .galeria-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .galeria-item {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 12px;
        background: #f5f5f5;
        cursor: zoom-in;
    }

        .galeria-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .35s ease;
        }

        .galeria-item:hover img {
            transform: scale(1.035);
        }

    .galeria-sem-imagem {
        min-height: 500px;
        border-radius: 12px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
    }

        .galeria-sem-imagem i {
            font-size: 70px;
        }

    /* =========================================================
           INFORMAÇÕES
           ========================================================= */

    .produto-info {
        padding-left: 25px;
    }

    .produto-marca {
        font-size: .9rem;
        color: #777;
        text-transform: uppercase;
        letter-spacing: .8px;
