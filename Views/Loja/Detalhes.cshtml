<div class="container produto-detalhes">

    <div class="row g-4">

        <!-- =====================================================
             GALERIA
             ===================================================== -->

        <div class="col-lg-6">

            <div class="produto-galeria">

                <div id="galeriaImagens"
                     class="galeria-grid">
                </div>

                <div id="galeriaSemImagem"
                     class="galeria-sem-imagem d-none">

                    <i class="bi bi-image"></i>

                </div>

            </div>

        </div>


        <!-- =====================================================
             INFORMAÇÕES
             ===================================================== -->

        <div class="col-lg-6">

            <div class="produto-info">

                @if (Model.Marca != null)
                {
                    <div class="produto-marca">
                        @Model.Marca.Nome
                    </div>
                }

                <h1 class="produto-titulo">
                    @Model.Nome
                </h1>

                <div class="produto-cor-titulo">
                    Cor:
                    <strong id="nomeCorTitulo">
                        @(corParaInicializar?.Nome ?? "Selecione uma cor")
                    </strong>
                </div>

                @if (Model.Categoria != null)
                {
                    <span class="produto-categoria">
                        @Model.Categoria.Nome
                    </span>
                }


                <!-- =================================================
                     PREÇO
                     ================================================= -->
                @if (Model.EmPromocao &&
                                     Model.PrecoPromocional.HasValue &&
                                     Model.PrecoPromocional.Value > 0 &&
                                     Model.PrecoPromocional.Value < Model.Preco)
                {
                    <div class="produto-preco">

                        <span class="produto-preco-antigo">
                            @Model.Preco.ToString("C2")
                        </span>

                        <span class="produto-preco-promocional">
                            @Model.PrecoPromocional.Value.ToString("C2")
                        </span>

                        <span class="produto-promocao">
                            PROMOÇÃO
                        </span>

                    </div>
                }
                else
                {
                    <div class="produto-preco">

                        <span class="produto-preco-atual">
                            @Model.Preco.ToString("C2")
                        </span>

                    </div>
                }


                <!-- =================================================
                     DESCRIÇÃO
                     ================================================= -->
                @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                {
                    <div class="produto-descricao">

                        <h5>
                            Descrição
                        </h5>

                        <p>
                            @Model.Descricao
                        </p>

                    </div>
                }


                <!-- =================================================
                     OPÇÕES
                     ================================================= -->
                @if (estoque.Any())
                {
                    <div class="mt-4">

                        <h5 class="selecao-titulo">
                            Escolha suas opções
                        </h5>


                        <!-- ==============================
                             COR
                             ============================== -->
                        @if (coresComImagens.Any())
                        {
                            <div class="mt-3">

                                <div class="cor-selecionada-texto">
                                    Cor:
                                    <strong id="nomeCorSelecionada">
                                        @(corParaInicializar?.Nome ?? "Selecione uma cor")
                                    </strong>
                                </div>

                                <div class="cores-container">

                                    @foreach (var cor in coresComImagens)
                                    {
                                        <button type="button"
                                                class="cor-opcao @(corParaInicializar?.Id == cor.Id ? "active" : "")"
                                                data-cor="@cor.Nome"
                                                data-cor-id="@cor.Id"
                                                aria-label="@cor.Nome"
                                                title="@cor.Nome">

                                            <span class="cor-circulo"
                                                  data-cor-nome="@cor.Nome">
                                            </span>

                                        </button>
                                    }

                                </div>

                            </div>
                        }

                        <!-- ==============================
                             TAMANHO
                             ============================== -->

                        <div class="mt-4 tamanho-produto-section">

                            <div class="selecao-titulo mb-2">
                                <i class="bi bi-question-circle"></i>
                                Ficou com dúvidas sobre o seu tamanho?
                            </div>


                            <!-- ==============================
                                 TAMANHO RECOMENDADO
                                 FICA OCULTO ATÉ O CLIENTE
                                 CONCLUIR O PROVADOR
                                 ============================== -->

                            <div id="tamanhoRecomendado"
                                 class="tamanho-recomendado d-none">

                                <div class="tamanho-recomendado-label">
                                    Tamanho recomendado
                                </div>

                                <div class="tamanho-recomendado-valor">

                                    <span id="tamanhoRecomendadoValor">
                                        G
                                    </span>

                                    <i class="bi bi-check-circle-fill"></i>

                                </div>

                                <small>
                                    Ideal para suas medidas
                                </small>

                            </div>


                            <!-- ==============================
                                 BOTÕES DO PROVADOR
                                 ============================== -->

                            <div class="tamanho-ajuda-container">

                                <button type="button"
                                        class="btn btn-outline-dark tamanho-ajuda-btn"
                                        id="btnDescobrirTamanho">

                                    <i class="bi bi-person-standing me-2"></i>

                                    <span>
                                        Descubra seu tamanho
                                    </span>

                                </button>


                                <button type="button"
                                        class="btn btn-outline-dark tamanho-ajuda-btn"
                                        id="btnTabelaMedidas">

                                    <i class="bi bi-rulers me-2"></i>

                                    <span>
                                        Tabela de medidas
                                    </span>

                                </button>

                            </div>


                            <!-- ==============================
                                 TAMANHOS DISPONÍVEIS
                                 ============================== -->

                            <div class="mt-3">

                                <div class="small text-muted mb-2">
                                    Tamanhos disponíveis
                                </div>

                                <div id="tamanhosContainer"
                                     class="tamanhos-container">
                                </div>

                            </div>

                        </div>


                        <!-- ==============================
                             ESTOQUE
                             ============================== -->

                        <div class="mt-4">

                            <div id="estoqueDisponivel"
                                 class="alert alert-secondary">

                                <i class="bi bi-info-circle"></i>

                                Selecione a cor e o tamanho.

                            </div>

                        </div>


                        <!-- ==============================
                             QUANTIDADE
                             ============================== -->

                        <div class="mt-4">

                            <label class="selecao-titulo">
                                Quantidade
                            </label>

                            <div class="input-group quantidade-container">

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        id="diminuirQuantidade">

                                    <i class="bi bi-dash"></i>

                                </button>

                                <input type="number"
                                       id="quantidade"
                                       class="form-control text-center"
                                       value="1"
                                       min="1"
                                       readonly />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        id="aumentarQuantidade">

                                    <i class="bi bi-plus"></i>

                                </button>

                            </div>

                        </div>


                        <!-- ==============================
                             CARRINHO
                             ============================== -->

                        <div class="mt-4">

                            <form asp-controller="Carrinho"
                                  asp-action="Adicionar"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="produtoId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="cor"
                                       id="corSelecionada" />

                                <input type="hidden"
                                       name="tamanho"
                                       id="tamanhoSelecionado" />

                                <input type="hidden"
                                       name="quantidade"
                                       id="quantidadeSelecionada"
                                       value="1" />

                                <button type="submit"
                                        id="btnAdicionarCarrinho"
                                        class="btn btn-primary btn-lg w-100 btn-adicionar-carrinho"
                                        disabled>

                                    <i class="bi bi-cart-plus me-2"></i>

                                    Adicionar ao carrinho

                                </button>

                            </form>

                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-4">

                        <i class="bi bi-exclamation-circle me-2"></i>

                        Produto temporariamente indisponível.

                    </div>
                }


                <!-- =================================================
                     VOLTAR
                     ================================================= -->

                <div class="mt-4">

                    <a asp-action="Produtos"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-2"></i>

                        Voltar para a loja

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

