        font-weight: 600;
        font-size: 1rem;
    }

    /* =========================================================
           MODAL
           ========================================================= */

    .imagem-modal {
        max-width: 95vw;
        max-height: 85vh;
        object-fit: contain;
    }

    /* =========================================================
           RESPONSIVO
           ========================================================= */

    @@media (max-width: 991px) {

        .produto-info {
            padding-left: 0;
            margin-top: 20px;
        }

        .produto-titulo {
            font-size: 1.7rem;
        }
    }

    @@media (max-width: 575px) {

        .produto-detalhes {
            padding-top: 15px;
        }

        .galeria-grid {
            gap: 8px;
        }

        .galeria-item {
            border-radius: 8px;
        }

        .produto-titulo {
            font-size: 1.45rem;
        }

        .produto-preco-atual,
        .produto-preco-promocional {
            font-size: 1.7rem;
        }

        .cor-opcao {
