            height: 43px;
        }
    }

/* =========================================================
   PROVADOR VIRTUAL
   ========================================================= */

.modal-provador-dialog {
    width: calc(100% - 30px);
    max-width: 1100px;
    height: 600px;
    margin: auto;
}

.modal-provador-content {
    position: relative;
    overflow: hidden;
    height: 600px;
    border: none;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
}


/* =========================================================
   FUNDO DO MODAL
   ========================================================= */

.modal-backdrop.show {
    opacity: .72;
}


/* =========================================================
   BOTÃO FECHAR
   ========================================================= */

.modal-provador-fechar {
    position: absolute;

    top: 16px;
    right: 16px;

    z-index: 20;

    width: 34px;
    height: 34px;

    padding: 8px;

    border-radius: 50%;

    background-color: rgba(255, 255, 255, .95);

    opacity: .85;
}

.modal-provador-fechar:hover {
    opacity: 1;
}


/* =========================================================
   ESTRUTURA
   ========================================================= */

.provador-layout {
    display: grid;

    grid-template-columns: 42% 58%;

    min-height: 500px;
}


/* =========================================================
   IMAGEM
   ========================================================= */

.provador-imagem {
    position: relative;

    min-height: 500px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

