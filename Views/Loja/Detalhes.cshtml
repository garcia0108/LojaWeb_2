if (idadeProvador) {
    idadeProvador.addEventListener('input', function () {
        const idade = parseInt(idadeProvador?.value || 0);
        if (window.dadosProvador) {
            window.dadosProvador.idade = idade;
        }
        atualizarAvatarDinamicamente();
    });
}

