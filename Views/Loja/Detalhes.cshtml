        function carregarTamanhos() {

            const container =
                document.getElementById(
                    "tamanhosContainer"
                );

            if (!container) {
                return;
            }

            container.innerHTML = "";

            const tamanhos = [
                "PP",
                "P",
                "M",
                "G",
                "GG",
                "XG"
                
            ];

            const tamanhosDisponiveis =
                estoque
                    .filter(e =>
                        corSelecionada &&
                        e.Cor === corSelecionada &&
                        e.Quantidade > 0
                    )
                    .map(e => e.Tamanho)
                    .filter(t => t)
                    .map(t => t.toUpperCase());

            tamanhos.forEach(tamanho => {

                const disponivel =
                    tamanhosDisponiveis.includes(
                        tamanho
                    );

                const botao =
                    document.createElement("button");

                botao.type = "button";

                botao.className =
                    "produto-tamanho";

                if (
                    tamanhoSelecionado &&
                    tamanhoSelecionado.toUpperCase() === tamanho
                ) {
                    botao.classList.add("active");
                }

                botao.textContent =
                    tamanho;

                botao.dataset.tamanho =
                    tamanho;

                botao.disabled =
                    !disponivel;

                botao.addEventListener(
                    "click",
                    function() {

                        document
                            .querySelectorAll(
                                ".produto-tamanho"
                            )
                            .forEach(b =>
                                b.classList.remove("active")
                            );

                        this.classList.add("active");

                        tamanhoSelecionado =
                            this.dataset.tamanho;

                        document
                            .getElementById(
                                "tamanhoSelecionado"
                            )
                            .value =
                            tamanhoSelecionado;

                        verificarEstoque();

                    }
                );

                container.appendChild(botao);

            });

        }


