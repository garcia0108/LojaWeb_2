        // =========================================================
        // VERIFICAR ESTOQUE
        // =========================================================

        function verificarEstoque() {

            const mensagem =
                document.getElementById(
                    "estoqueDisponivel"
                );

            const botaoCarrinho =
                document.getElementById(
                    "btnAdicionarCarrinho"
                );

            if (
                !corSelecionada ||
                !tamanhoSelecionado
            ) {

                mensagem.className =
                    "alert alert-secondary";

                mensagem.innerHTML =
                    '<i class="bi bi-info-circle me-2"></i>' +
                    'Selecione a cor e o tamanho.';

                botaoCarrinho.disabled =
                    true;

                estoqueSelecionado = 0;

                return;
            }


            const item =
                estoque.find(e =>
                    e.Cor === corSelecionada &&
                    e.Tamanho === tamanhoSelecionado
                );


            if (!item) {

                estoqueSelecionado = 0;

                mensagem.className =
                    "alert alert-danger";

                mensagem.innerHTML =
                    '<i class="bi bi-x-circle me-2"></i>' +
                    'Essa combinação não está disponível.';

                botaoCarrinho.disabled =
                    true;

                return;
            }


            estoqueSelecionado =
                item.Quantidade;


            if (estoqueSelecionado <= 0) {

                mensagem.className =
                    "alert alert-danger";

                mensagem.innerHTML =
                    '<i class="bi bi-x-circle me-2"></i>' +
                    'Produto esgotado.';

                botaoCarrinho.disabled =
                    true;

                return;
            }


            mensagem.className =
                "alert alert-success";

            mensagem.innerHTML =
                '<i class="bi bi-check-circle me-2"></i>' +
                'Disponível: ' +
                estoqueSelecionado +
                ' unidade(s).';


            const campoQuantidade =
                document.getElementById(
                    "quantidade"
                );

            campoQuantidade.value =
                1;

            document
                .getElementById(
                    "quantidadeSelecionada"
                )
                .value = 1;

            botaoCarrinho.disabled =
                false;

        }


        // =========================================================
        // QUANTIDADE - DIMINUIR
        // =========================================================

        document
            .getElementById(
                "diminuirQuantidade"
            )
            ?.addEventListener(
