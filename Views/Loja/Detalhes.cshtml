}

.passo2-cabecalho {
    margin-bottom: 25px;
}

.passo2-cabecalho .provador-titulo {
    margin-bottom: 10px;
}

.passo2-cabecalho .provador-subtitulo {
    max-width: 420px;
    margin-bottom: 0;
}


/* =========================================
   MEDIDAS
   ========================================= */

.passo2-medidas {
    width: 100%;
    max-width: 380px;
}

.medida-provador {
    margin-bottom: 27px;
}

.medida-provador:last-child {
    margin-bottom: 0;
}


/* =========================================
   AVATAR
   ========================================= */

.passo2-avatar-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    min-width: 0;
    padding-left: 20px;
}

.avatar-provador {
    --avatar-cor: #966345;

    position: relative;
    width: 125px;
    height: 245px;

    transform: scale(1.35);
    transform-origin: center center;
}


/* Cabeça */

.avatar-cabeca {
    position: absolute;
    width: 58px;
    height: 70px;
    background: var(--avatar-cor);
    border-radius: 48% 48% 45% 45%;
    top: 0;
    left: 34px;
}


/* Pescoço */

.avatar-pescoco {
    position: absolute;
    width: 30px;
    height: 25px;
    background: var(--avatar-cor);
    top: 57px;
    left: 47px;
}


/* =========================================================
   CORPO DO AVATAR
   ========================================================= */

.avatar-corpo {
    position: absolute;

    width: 92px;
    height: 125px;

    top: 72px;
    left: 17px;

    background: transparent;

    transition: none;
}


/* =========================================================
   TÓRAX
   ========================================================= */

.avatar-torax {
    position: absolute;

    width: 92px;
    height: 65px;

    top: 0;
    left: 0;

    background: var(--avatar-cor);

    border-radius: 42% 42% 28% 28%;

    transition:
        width .25s ease,
        left .25s ease;
}


/* =========================================================
   CINTURA
   ========================================================= */

.avatar-cintura {
    position: absolute;

    width: 84px;
    height: 45px;

    top: 48px;
    left: 4px;

    background: var(--avatar-cor);

    border-radius: 20%;

    transition:
        width .25s ease,
        left .25s ease;
}


/* =========================================================
   QUADRIL
   ========================================================= */

.avatar-quadril {
    position: absolute;

    width: 92px;
    height: 52px;

    top: 76px;
    left: 0;

    background: var(--avatar-cor);

    border-radius: 25% 25% 42% 42%;

    transition:
        width .25s ease,
        left .25s ease;
}


/* Braços */

.avatar-braco {
    position: absolute;
    width: 24px;
    height: 112px;
    background: var(--avatar-cor);
    border-radius: 15px;
    top: 78px;

    transition:
        transform .25s ease;
}

.avatar-braco-esquerdo {
    left: 3px;
    transform: rotate(8deg);
}

.avatar-braco-direito {
    right: 3px;
    transform: rotate(-8deg);
}


/* Pernas */

.avatar-perna {
    position: absolute;
    width: 36px;
    height: 75px;
    background: var(--avatar-cor);
    border-radius: 15px;
    top: 183px;

    transition:
        width .25s ease,
        transform .25s ease;
}

.avatar-perna-esquerda {
    left: 28px;
}

.avatar-perna-direita {
    right: 28px;
}


/* =========================================
   CORES DO AVATAR
   ========================================= */

.avatar-cores {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.avatar-cor-opcao {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;

    transition:
        transform .2s ease,
        border-color .2s ease;
}

.avatar-cor-opcao:hover {
    transform: scale(1.12);
}

.avatar-cor-opcao.avatar-cor-selecionada {
    border-color: #555;
    box-shadow: 0 0 0 1px #fff;
}


/* =========================================
   MEDIDAS
   ========================================= */

.passo2-medidas {
    width: 330px;
}

.medida-provador {
    margin-bottom: 24px;
}

.medida-provador:last-child {
    margin-bottom: 0;
}

.medida-titulo {
    text-align: center;
    font-size: 13px;
    color: #555;
    margin-bottom: 7px;
}

.medida-controle {
    display: flex;
    align-items: center;
    gap: 12px;
}

.medida-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #fff;
    box-shadow: 0 3px 10px rgba(0, 0, 0, .10);
    font-size: 21px;
    line-height: 1;
    color: #333;
    cursor: pointer;

    transition:
        background .2s ease,
        transform .15s ease;
}

.medida-btn:disabled {
    opacity: .35;
    cursor: not-allowed;
    box-shadow: none;
}

.medida-btn:disabled:hover {
    background: #fff;
}

.medida-btn:hover {
    background: #f5f5f5;
}

.medida-btn:active {
    transform: scale(.94);
}


/* =========================================
   RÉGUA
   ========================================= */

.medida-regua {
    position: relative;
    width: 240px;
    height: 24px;
    cursor: pointer;
}

.regua-linha {
    position: absolute;
    top: 11px;
    left: 0;
    right: 0;
    height: 1px;
    background: #555;
}


/* Os 5 risquinhos */

.regua-marcas {
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 13px;
    display: flex;
    justify-content: space-between;
}

.regua-marcas span {
    width: 1px;
    height: 13px;
    background: #555;
}


/* Bolinha */

.regua-indicador {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #333;

    top: 5px;

    left: 50%;

    transform: translateX(-50%);

    transition:
        left .2s ease;
}


/* =========================================
   NAVEGAÇÃO
   ========================================= */
.provador-passo2 {
    position: relative !important;
    width: 100%;
    height: 100%;
    min-height: 0;
}

.passo2-footer {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;

    width: 100% !important;
    height: 70px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;

    padding: 0 55px !important;
    margin: 40px !important;

    z-index: 100 !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.passo2-navegacao {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;

    position: relative !important;
    z-index: 101 !important;
}

.passo2-footer .provador-btn-voltar,
.passo2-footer .provador-btn-proximo {
    display: inline-flex !important;

    position: relative !important;
    z-index: 102 !important;

    visibility: visible !important;
    opacity: 1 !important;

    align-items: center !important;
    justify-content: center !important;
}

.passo2-footer .provador-indicadores {
    position: absolute !important;

    left: 50% !important;
    bottom: 15px !important;

    transform: translateX(-50%) !important;

    display: flex !important;
    z-index: 101 !important;
}

/* =========================================================
   PASSO 2 - LAYOUT EM TELA ÚNICA
   ========================================================= */

.provador-layout.passo2-ativo {
    grid-template-columns: 1fr;
}

.provador-layout.passo2-ativo .provador-imagem {
    display: none;
}

.provador-layout.passo2-ativo .provador-conteudo {
    width: 100%;
    min-width: 0;
    padding: 1px 60px 20px;
}

/* =========================================================
   AVATAR 3D
   ========================================================= */

.avatar-3d-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 580px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent;
}

#avatar3DCanvas {
    width: 100%;
    height: 100%;

    display: block;
}

.avatar-3d-carregando {
    position: absolute;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    font-size: 13px;
    color: #777;

    white-space: nowrap;
}
