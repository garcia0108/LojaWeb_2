            carousel.insertBefore(
                clone,
                carousel.firstChild
            );

        });


        // =========================================
        // TODOS OS CARDS
        // =========================================

        const cards =
            Array.from(
                carousel.querySelectorAll(".categoria-card")
            );


        // =========================================
        // MOVIMENTO
        // =========================================

        function obterMovimento() {

            const card =
                cards[0];

            const estilo =
                window.getComputedStyle(carousel);

            const gap =
                parseFloat(
                    estilo.columnGap ||
                    estilo.gap
                ) || 0;

            return card.offsetWidth + gap;
        }


        // =========================================
        // POSIÇÃO INICIAL
        // =========================================

        function posicionarInicialmente() {

            const movimento =
                obterMovimento();

            carousel.scrollLeft =
                quantidade * movimento;

        }


        requestAnimationFrame(function () {

            posicionarInicialmente();

        });


        // =========================================
        // CONTROLE DE MOVIMENTO
        // =========================================

        let movimentoEmAndamento = false;


        // =========================================
        // DIREITA
        // =========================================

        next.addEventListener("click", function () {

            if (movimentoEmAndamento) {
                return;
            }

            movimentoEmAndamento = true;


            const movimento =
                obterMovimento();


            carousel.scrollBy({

                left: movimento,

                behavior: "smooth"

            });


            setTimeout(function () {

                verificarLimites();

                movimentoEmAndamento = false;

            }, 450);

        });


        // =========================================
        // ESQUERDA
        // =========================================

        previous.addEventListener("click", function () {

            if (movimentoEmAndamento) {
                return;
            }

            movimentoEmAndamento = true;


            const movimento =
                obterMovimento();


            carousel.scrollBy({

                left: -movimento,

                behavior: "smooth"

            });


            setTimeout(function () {

                verificarLimites();

                movimentoEmAndamento = false;

            }, 450);

        });


        // =========================================
        // CORRIGIR LIMITES
        // =========================================

        function verificarLimites() {

            const primeiroOriginal =
                cardsOriginais[0];

            const ultimoOriginal =
                cardsOriginais[quantidade - 1];


            const inicioOriginal =
                primeiroOriginal.offsetLeft;


            const inicioUltimoOriginal =
                ultimoOriginal.offsetLeft;


            const movimento =
                obterMovimento();


            // =====================================
            // CLONES DA DIREITA
            // =====================================

            if (
                carousel.scrollLeft >=
                inicioUltimoOriginal + movimento
            ) {

                carousel.style.scrollBehavior =
                    "auto";


                carousel.scrollLeft =
                    inicioOriginal +
                    (
                        carousel.scrollLeft -
                        (
                            inicioUltimoOriginal +
                            movimento
                        )
                    );


                carousel.style.scrollBehavior =
                    "smooth";
            }


            // =====================================
            // CLONES DA ESQUERDA
            // =====================================

            if (
                carousel.scrollLeft <
                inicioOriginal
            ) {

                carousel.style.scrollBehavior =
                    "auto";


                carousel.scrollLeft =
                    inicioUltimoOriginal -
                    (
                        inicioOriginal -
                        carousel.scrollLeft
                    );


                carousel.style.scrollBehavior =
                    "smooth";
            }

        }


        // =========================================
        // REDIMENSIONAMENTO
        // =========================================

        window.addEventListener(
            "resize",
            function () {

                const movimento =
                    obterMovimento();

                carousel.style.scrollBehavior =
                    "auto";

                carousel.scrollLeft =
                    quantidade * movimento;

                carousel.style.scrollBehavior =
                    "smooth";

            }
        );

    });

    //PROMOÇÃO MASCULINA

        document.addEventListener("DOMContentLoaded", function () {

            const paginas =
                document.querySelectorAll(
                    "#promocoesMasculinas .promocao-pagina"
                );

            const bolinhas =
                document.querySelectorAll(
                    ".promocao-bolinha"
                );

            const anterior =
                document.getElementById(
                    "promocaoAnterior"
                );

            const proxima =
                document.getElementById(
                    "promocaoProxima"
                );


            if (paginas.length === 0) {
                return;
            }


            let paginaAtual = 0;


            function mostrarPagina(numero) {

                if (numero < 0 ||
                    numero >= paginas.length) {

                    return;
                }


                paginas.forEach(function (pagina, index) {

                    if (index === numero) {

                        pagina.classList.remove("d-none");

                    } else {

                        pagina.classList.add("d-none");

                    }

                });


                bolinhas.forEach(function (bolinha, index) {

                    if (index === numero) {

                        bolinha.classList.add("ativa");

                    } else {

                        bolinha.classList.remove("ativa");

                    }

                });


                paginaAtual = numero;


                anterior.disabled =
                    paginaAtual === 0;

                proxima.disabled =
                    paginaAtual === paginas.length - 1;

            }


            proxima.addEventListener("click", function () {

                if (paginaAtual < paginas.length - 1) {

                    mostrarPagina(paginaAtual + 1);

                }

            });


            anterior.addEventListener("click", function () {

                if (paginaAtual > 0) {

                    mostrarPagina(paginaAtual - 1);

                }

            });


            bolinhas.forEach(function (bolinha) {

                bolinha.addEventListener("click", function () {

                    const pagina =
                        parseInt(
                            this.dataset.pagina
                        );

                    mostrarPagina(pagina);

                });

            });


            mostrarPagina(0);

        });

       

        document.addEventListener("DOMContentLoaded", function () {

            const botaoMasculino =
                document.getElementById(
                    "botaoPromocaoMasculino"
                );

            const botaoFeminino =
                document.getElementById(
                    "botaoPromocaoFeminino"
                );

            const masculino =
                document.getElementById(
