<script>

    //BANNER

    document.addEventListener("DOMContentLoaded", function () {

        const slides = document.querySelectorAll(".banner-slide");
        const indicadores = document.querySelectorAll(".banner-indicador");

        const anterior = document.querySelector(".banner-prev");
        const proximo = document.querySelector(".banner-next");

        let slideAtual = 0;

        function mostrarSlide(indice) {

            if (indice >= slides.length) {
                slideAtual = 0;
            }

            else if (indice < 0) {
                slideAtual = slides.length - 1;
            }

            else {
                slideAtual = indice;
            }


            slides.forEach(function (slide) {
                slide.classList.remove("ativo");
            });


            indicadores.forEach(function (indicador) {
                indicador.classList.remove("ativo");
            });


            slides[slideAtual].classList.add("ativo");


            if (indicadores[slideAtual]) {
                indicadores[slideAtual].classList.add("ativo");
            }
        }


        anterior.addEventListener("click", function () {
            mostrarSlide(slideAtual - 1);
        });


        proximo.addEventListener("click", function () {
            mostrarSlide(slideAtual + 1);
        });


        indicadores.forEach(function (indicador, indice) {

            indicador.addEventListener("click", function () {
                mostrarSlide(indice);
            });

        });


        // TROCA AUTOMÁTICA
        setInterval(function () {
            mostrarSlide(slideAtual + 1);
        }, 5000);

    });

    //ÁRE DE BENEFÍCIO RESPONSÍVEL EM CARROSEL INFINITO AUTOMÁTICO
    
    document.addEventListener("DOMContentLoaded", function () {

        const beneficios = document.querySelectorAll(
            ".beneficio-item"
        );

        const anterior = document.querySelector(
            ".beneficio-prev"
        );

        const proximo = document.querySelector(
            ".beneficio-next"
        );


        if (
            beneficios.length === 0 ||
            !anterior ||
            !proximo
        ) {
            return;
        }


        let beneficioAtual = 0;


        function mostrarBeneficio(indice) {

            // LOOP INFINITO

            if (indice >= beneficios.length) {
                beneficioAtual = 0;
            }
            else if (indice < 0) {
                beneficioAtual = beneficios.length - 1;
            }
            else {
                beneficioAtual = indice;
            }


            // Esconde todos

            beneficios.forEach(function (beneficio) {

                beneficio.classList.remove("ativo");

            });


            // Mostra o atual

            beneficios[beneficioAtual]
                .classList.add("ativo");

        }


        // =========================================
        // SETA ESQUERDA
        // =========================================

        anterior.addEventListener("click", function () {

            mostrarBeneficio(
                beneficioAtual - 1
            );

        });


        // =========================================
        // SETA DIREITA
        // =========================================

        proximo.addEventListener("click", function () {

            mostrarBeneficio(
                beneficioAtual + 1
            );

        });


        // =========================================
        // TROCA AUTOMÁTICA
        // =========================================

        setInterval(function () {

            mostrarBeneficio(
                beneficioAtual + 1
            );

        }, 4000);


        // =========================================
        // INICIA NO PRIMEIRO
        // =========================================

        mostrarBeneficio(0);

    });

    //COMBO
    document.addEventListener("DOMContentLoaded", function () {

        const carousel =
            document.getElementById("carouselMasculino");

        const previous =
            document.querySelector(".categoria-prev");

        const next =
            document.querySelector(".categoria-next");


        if (!carousel || !previous || !next) {
            return;
        }


        // =========================================
        // PEGAR OS CARDS ORIGINAIS
        // =========================================

        const cardsOriginais =
            Array.from(
                carousel.querySelectorAll(".categoria-card")
            );


        const quantidade =
            cardsOriginais.length;


        // Se não houver cards suficientes,
        // não precisamos do loop.

        if (quantidade <= 1) {
            return;
        }


        // =========================================
        // CRIAR CÓPIAS
        // =========================================

        cardsOriginais.forEach(function (card) {

            const clone =
                card.cloneNode(true);

            carousel.appendChild(clone);

        });


        cardsOriginais.forEach(function (card) {

            const clone =
                card.cloneNode(true);

            carousel.insertBefore(
                clone,
                carousel.firstChild
            );

        });


        // =========================================
        // ATUALIZAR OS CARDS
        // =========================================

        const cards =
            Array.from(
                carousel.querySelectorAll(".categoria-card")
            );


        // =========================================
        // CALCULAR MOVIMENTO
        // =========================================

        function obterMovimento() {

            const card =
                cards[0];

            const estilo =
                window.getComputedStyle(carousel);

            const gap =
                parseFloat(
                    estilo.columnGap ||
                    estilo.gap
                ) || 0;

            return card.offsetWidth + gap;
        }


        // =========================================
        // POSIÇÃO INICIAL
        // =========================================

        function posicionarInicialmente() {

    const movimento = obterMovimento();

    carousel.scrollLeft =
        quantidade * movimento;
}


        // Espera o navegador terminar
        // de montar o layout.

        requestAnimationFrame(function () {

            posicionarInicialmente();

        });


        // =========================================
        // CONTROLAR MOVIMENTO
        // =========================================

        let movimentoEmAndamento = false;


        // =========================================
        // DIREITA
        // =========================================

        next.addEventListener("click", function () {

            if (movimentoEmAndamento) {
                return;
            }

            movimentoEmAndamento = true;


            const movimento =
                obterMovimento();


            carousel.scrollBy({

                left: movimento,

                behavior: "smooth"

            });


            setTimeout(function () {

                verificarLimites();

                movimentoEmAndamento = false;

            }, 450);

        });


        // =========================================
        // ESQUERDA
        // =========================================

        previous.addEventListener("click", function () {

            if (movimentoEmAndamento) {
                return;
            }

            movimentoEmAndamento = true;


            const movimento =
                obterMovimento();


            carousel.scrollBy({

                left: -movimento,

                behavior: "smooth"

            });


            setTimeout(function () {

                verificarLimites();

                movimentoEmAndamento = false;

            }, 450);

        });


        // =========================================
        // CORRIGIR LIMITES
        // =========================================

        function verificarLimites() {

            const primeiroOriginal =
                cardsOriginais[0];

            const ultimoOriginal =
                cardsOriginais[quantidade - 1];


            const inicioOriginal =
                primeiroOriginal.offsetLeft;


            const inicioUltimoOriginal =
                ultimoOriginal.offsetLeft;


            const movimento =
                obterMovimento();


            // =====================================
            // PASSOU PARA OS CLONES DA DIREITA
            // =====================================

            if (
                carousel.scrollLeft >=
                inicioUltimoOriginal + movimento
            ) {

                carousel.style.scrollBehavior =
                    "auto";


                carousel.scrollLeft =
                    inicioOriginal +
                    (
                        carousel.scrollLeft -
                        (
                            inicioUltimoOriginal +
                            movimento
                        )
                    );


                carousel.style.scrollBehavior =
                    "smooth";
            }


            // =====================================
            // PASSOU PARA OS CLONES DA ESQUERDA
            // =====================================

            if (
                carousel.scrollLeft <
                inicioOriginal
            ) {

                carousel.style.scrollBehavior =
                    "auto";


                carousel.scrollLeft =
                    inicioUltimoOriginal -
                    (
                        inicioOriginal -
                        carousel.scrollLeft
                    );


                carousel.style.scrollBehavior =
                    "smooth";
            }

        }


        // =========================================
        // RECALCULAR AO REDIMENSIONAR A TELA
        // =========================================

        window.addEventListener(
            "resize",
            function () {

                const movimento =
                    obterMovimento();

                carousel.style.scrollBehavior =
                    "auto";

                carousel.scrollLeft =
                    quantidade * movimento;

                carousel.style.scrollBehavior =
                    "smooth";

    }
);

    });


    // =========================================
        // CARROSEL FEMININO    
        // =========================================

    document.addEventListener("DOMContentLoaded", function () {

        const carousel =
