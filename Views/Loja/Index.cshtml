                );

            const feminino =
                document.getElementById(
                    "promocoesFemininas"
                );


            if (!botaoMasculino ||
                !botaoFeminino ||
                !masculino ||
                !feminino) {

                return;

            }


            // =========================================
            // MASCULINO BOTÃO
            // =========================================

            botaoMasculino.addEventListener(
                "click",
                function () {

                    masculino.classList.remove("d-none");

                    feminino.classList.add("d-none");


                    botaoMasculino.classList.remove(
                        "btn-outline-dark"
                    );

                    botaoMasculino.classList.add(
                        "btn-dark"
                    );


                    botaoFeminino.classList.remove(
                        "btn-dark"
                    );

                    botaoFeminino.classList.add(
                        "btn-outline-dark"
                    );

                }
            );


            // =========================================
            // FEMININO BOTÃO
            // =========================================

            botaoFeminino.addEventListener(
                "click",
                function () {

                    feminino.classList.remove("d-none");

                    masculino.classList.add("d-none");


                    botaoFeminino.classList.remove(
                        "btn-outline-dark"
                    );

                    botaoFeminino.classList.add(
                        "btn-dark"
                    );


                    botaoMasculino.classList.remove(
                        "btn-dark"
                    );

                    botaoMasculino.classList.add(
                        "btn-outline-dark"
                    );

                }
            );

        });

            
        //BOTÕES MASCULINO/FEMININO

           

        document.addEventListener("DOMContentLoaded", function () {

            const botoes = document.querySelectorAll(
                ".promocao-genero-btn"
            );

            const masculino = document.getElementById(
                "promocoesMasculinas"
            );

            const feminino = document.getElementById(
                "promocoesFemininas"
            );


            if (!masculino || !feminino || botoes.length === 0) {
                return;
            }


            botoes.forEach(function (botao) {

                botao.addEventListener("click", function () {

                    // Remove o ativo de TODOS os botões
                    botoes.forEach(function (item) {

                        item.classList.remove("ativo");

                    });


                    // Coloca ativo somente no botão clicado
                    this.classList.add("ativo");


                    // Descobre qual botão foi clicado
                    const genero = this.dataset.genero;


                    // ============================
                    // MASCULINO
                    // ============================

                    if (genero === "masculino") {

                        masculino.classList.add("ativo");

                        feminino.classList.remove("ativo");

                    }


                    // ============================
                    // FEMININO
                    // ============================

                    if (genero === "feminino") {

                        feminino.classList.add("ativo");

                        masculino.classList.remove("ativo");

                    }

                });

            });

        });

        //SETAS, PAGINAÇÃO E BOLINHA INDICADORA DE PAGINA PROMOÇÃO FEMININA
            
        document.addEventListener("DOMContentLoaded", function () {

            const paginas = document.querySelectorAll(
                "#promocoesFemininas .promocao-pagina-feminina"
            );

            const bolinhas = document.querySelectorAll(
                "#promocoesFemininas .promocao-bolinha-feminino"
            );

            const anterior = document.getElementById(
                "promocaoAnteriorFeminino"
            );

            const proxima = document.getElementById(
                "promocaoProximaFeminino"
            );


            if (
                paginas.length === 0 ||
                !anterior ||
                !proxima
            ) {
                return;
            }


            let paginaAtual = 0;


            function mostrarPagina(numero) {

                // Impede passar dos limites

                if (numero < 0) {
                    numero = 0;
                }

                if (numero >= paginas.length) {
                    numero = paginas.length - 1;
                }


                paginaAtual = numero;


                // Esconde todas as páginas

                paginas.forEach(function (pagina) {

                    pagina.classList.add("d-none");

                });


                // Mostra somente a página atual

                paginas[paginaAtual].classList.remove("d-none");


                // Atualiza as bolinhas

                bolinhas.forEach(function (bolinha, indice) {

                    bolinha.classList.remove("ativa");

                    if (indice === paginaAtual) {

                        bolinha.classList.add("ativa");

                    }

                });


                // Controla a seta esquerda

                anterior.disabled = paginaAtual === 0;


                // Controla a seta direita

                proxima.disabled =
                    paginaAtual === paginas.length - 1;

            }


            // =========================================
            // SETA ESQUERDA
            // =========================================

            anterior.addEventListener("click", function () {

                mostrarPagina(paginaAtual - 1);

            });


            // =========================================
            // SETA DIREITA
            // =========================================

            proxima.addEventListener("click", function () {

                mostrarPagina(paginaAtual + 1);

            });


            // =========================================
            // BOLINHAS
            // =========================================

            bolinhas.forEach(function (bolinha, indice) {

                bolinha.addEventListener("click", function () {

                    mostrarPagina(indice);

                });

            });


            // =========================================
            // INICIA NA PRIMEIRA PÁGINA
            // =========================================

            mostrarPagina(0);

        });
</script>




