@model IEnumerable<LojaWeb_2.Models.Produto>

@{
    ViewData["Title"] = "Loja";
}

<div class="container mt-4">

    <!-- =========================================
     BANNER PRINCIPAL
     ========================================= -->

    <section class="banner-principal">

        <div class="banner-carousel">

            <!-- BANNER 1 -->
            <div class="banner-slide ativo">
                <img src="~/uploads/banners/banner1.webp"
                     alt="Banner principal 1">
            </div>

            <!-- BANNER 2 -->
            <div class="banner-slide">
                <img src="~/uploads/banners/banner2.webp"
                     alt="Banner principal 2">
            </div>

            <!-- BANNER 3 -->
            <div class="banner-slide">
                <img src="~/uploads/banners/banner3.webp"
                     alt="Banner principal 3">
            </div>

            <!-- BANNER 4 -->
            <div class="banner-slide">
                <img src="~/uploads/banners/banner4.webp"
                     alt="Banner principal 4">
            </div>


            <!-- SETA ESQUERDA -->
            <button type="button"
                    class="banner-arrow banner-prev"
                    aria-label="Banner anterior">
                &#10094;
            </button>


            <!-- SETA DIREITA -->
            <button type="button"
                    class="banner-arrow banner-next"
                    aria-label="Próximo banner">
                &#10095;
            </button>


            <!-- INDICADORES -->
            <div class="banner-indicadores">

                <button type="button"
                        class="banner-indicador ativo"
                        data-slide="0"
                        aria-label="Banner 1"></button>

                <button type="button"
                        class="banner-indicador"
                        data-slide="1"
                        aria-label="Banner 2"></button>

                <button type="button"
                        class="banner-indicador"
                        data-slide="2"
                        aria-label="Banner 3"></button>

                <button type="button"
                        class="banner-indicador"
                        data-slide="3"
                        aria-label="Banner 4"></button>

            </div>

        </div>

    </section>

    <!-- =========================================
     ÁREA DE BENEFÍCIOS
     ========================================= -->

    <section class="beneficios-section">

        <div class="beneficios-carousel">

            <!-- BENEFÍCIO 1 -->
            <div class="beneficio-item ativo">
                <span class="beneficio-icone">✺</span>
                <span>10% de desconto na primeira compra</span>
            </div>

            <!-- BENEFÍCIO 2 -->
            <div class="beneficio-item">
                <span class="beneficio-icone">🛡</span>
                <span>Compra 100% segura</span>
            </div>

            <!-- BENEFÍCIO 3 -->
            <div class="beneficio-item">
                <span class="beneficio-icone">▣</span>
                <span>Até 10x sem juros</span>
            </div>

            <!-- BENEFÍCIO 4 -->
            <div class="beneficio-item">
                <span class="beneficio-icone">🚚</span>
                <span>Frete grátis acima de R$ 250,00</span>
            </div>


            <!-- SETA ESQUERDA - CELULAR -->
            <button type="button"
                    class="beneficio-arrow beneficio-prev"
                    aria-label="Benefício anterior">
                &#10094;
            </button>


            <!-- SETA DIREITA - CELULAR -->
            <button type="button"
                    class="beneficio-arrow beneficio-next"
                    aria-label="Próximo benefício">
                &#10095;
            </button>

        </div>

    </section>

    <!-- ========================================= -->
    <!-- BOTÃO CATÁLOGO COMPLETO -->
    <!-- ========================================= -->

    <div class="text-center mt-4 mb-4">

        <a asp-controller="Loja"
           asp-action="Produtos"
           class="btn btn-dark btn-lg px-5">

            <i class="bi bi-grid-3x3-gap"></i>
            Ver todos os produtos

        </a>

    </div>

    <!-- ========================================= -->
    <!-- COMBOS -->
    <!-- ========================================= -->
    @if (ViewBag.Combos != null &&
        ViewBag.Combos.Count > 0)
    {
        <section class="mb-5">

            <div class="text-center mb-4">

                <h2 class="fw-bold">
                    <i class="bi bi-box-seam"></i>
                    Nossos Combos
                </h2>

                <p class="text-muted">
                    Aproveite nossos combos especiais e economize.
                </p>

            </div>


            <div class="row g-4 justify-content-center">

                @foreach (var combo in ViewBag.Combos)
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="card combo-card h-100 shadow-sm border-0">


                            <!-- IMAGEM DO COMBO -->

                            <div class="combo-imagem">

                                @if (!string.IsNullOrEmpty(combo.Imagem))
                                {
                                    <img src="@combo.Imagem"
                                         alt="@combo.Nome" />
                                }
                                else
                                {
                                    <div class="combo-sem-imagem">

                                        <i class="bi bi-box-seam"></i>

                                    </div>
                                }

                            </div>


                            <!-- NOME -->

                            <div class="card-body text-center">

                                <h5 class="fw-bold mb-3">
                                    @combo.Nome
                                </h5>

 
                                    <!-- ========================================= -->
                                    <!-- BOTÃO -->
                                    <!-- ========================================= -->
                                    
                                    <form asp-controller="Carrinho"
                                          asp-action="AdicionarCombo"
                                          method="post"
                                          class="mt-auto form-adicionar-combo">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="comboId"
                                               value="@combo.Id" />

                                        <input type="hidden"
                                               name="quantidade"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-dark produto-btn w-100">

                                            <i class="bi bi-lightning-charge-fill me-1"></i>
                                            Compra rápida

                                        </button>

                                    </form>

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- VER TODOS -->

            <div class="text-center mt-4">

                <a asp-controller="Loja"
                   asp-action="Combos"
                   class="btn btn-outline-dark px-4">

                    <i class="bi bi-box-seam"></i>
                    Ver todos os combos

                </a>

            </div>

        </section>
    }


    <!-- ========================================= -->
    <!-- DIVISÃO -->
    <!-- ========================================= -->

    <hr class="my-5" />


    <!-- ========================================= -->
    <!-- CATEGORIAS MASCULINAS -->
    <!-- ========================================= -->
    @if (ViewBag.CategoriasMasculinas != null &&
        ViewBag.CategoriasMasculinas.Count > 0)
    {
        <section class="categoria-section mb-5">

            <div class="text-center mb-4">

                <h2 class="fw-bold">
                    👔 Masculino
                </h2>

                <p class="text-muted">
                    Encontre nossos produtos masculinos por categoria.
                </p>

            </div>


            <div class="categoria-carousel-wrapper">

                <!-- SETA ESQUERDA -->

                <button type="button"
                        class="categoria-arrow categoria-prev"
                        aria-label="Categorias anteriores">

                    <i class="bi bi-chevron-left"></i>

                </button>


                <!-- CARROSSEL -->

                <div class="categoria-carousel"
                     id="carouselMasculino">

                    @foreach (var categoria in ViewBag.CategoriasMasculinas)
                    {
                       <div class="categoria-card">

    <a asp-controller="Loja"
       asp-action="Masculino"
       asp-route-categoriaId="@categoria.Id"
       class="categoria-link">

        <!-- IMAGEM -->

        <div class="categoria-imagem">

            @if (!string.IsNullOrEmpty(categoria.Imagem))
            {
                <img src="@categoria.Imagem"
                     alt="@categoria.Nome" />
            }
            else
            {
                <div class="categoria-sem-imagem">

                    <i class="bi bi-image"></i>

                </div>
            }

        </div>


        <!-- NOME -->

        <div class="categoria-nome">

            @categoria.Nome

        </div>

    </a>

</div>
                    }

                </div>


                <!-- SETA DIREITA -->

                <button type="button"
                        class="categoria-arrow categoria-next"
                        aria-label="Próximas categorias">

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>


            <!-- VER TODOS -->

            <div class="text-center mt-4">

                <a asp-controller="Loja"
                   asp-action="Masculino"
                   class="btn btn-outline-dark px-4">

                    <i class="bi bi-grid"></i>
                    Ver todos os produtos masculinos

                </a>

            </div>

        </section>
    }

</div>

    <!-- ========================================= -->
    <!-- DIVISÃO -->
    <!-- ========================================= -->

    <hr class="my-5" />


<!-- ========================================= -->
<!-- CATEGORIAS FEMININAS -->
<!-- ========================================= -->

@if (ViewBag.CategoriasFemininas != null &&
     ViewBag.CategoriasFemininas.Count > 0)
{
    <section class="categoria-section categoria-feminino mb-5">

        <div class="text-center mb-4">

            <h2 class="fw-bold">
                👗 Feminino
            </h2>

            <p class="text-muted">
                Encontre produtos femininos por categoria.
            </p>

        </div>


        <!-- ========================================= -->
        <!-- CARROSSEL -->
        <!-- ========================================= -->

        <div class="categoria-carousel-wrapper">

            <!-- SETA ESQUERDA -->

            <button type="button"
                    class="categoria-arrow categoria-prev-feminino">

                <i class="bi bi-chevron-left"></i>

            </button>


            <!-- CARDS -->

            <div class="categoria-carousel"
                 id="carouselFeminino">

                @foreach (var categoria in ViewBag.CategoriasFemininas)
                {
                    <div class="categoria-card">

                        <a asp-controller="Loja"
                           asp-action="Feminino"
                           asp-route-categoriaId="@categoria.Id"
                           class="categoria-link">

                            <!-- IMAGEM FEMININA -->

                            <div class="categoria-imagem">

                                @if (!string.IsNullOrEmpty(
                                    categoria.ImagemFeminina))
                                {
                                    <img src="@categoria.ImagemFeminina"
                                         alt="@categoria.Nome" />
                                }
                                else
                                {
                                    <div class="categoria-sem-imagem">

                                        <i class="bi bi-image"></i>

                                    </div>
                                }

                            </div>


                            <!-- NOME -->

                            <div class="categoria-nome">

                                @categoria.Nome

                            </div>

                        </a>

                    </div>
                }

            </div>


            <!-- SETA DIREITA -->

            <button type="button"
                    class="categoria-arrow categoria-next-feminino">

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>


        <!-- ========================================= -->
        <!-- VER TODOS -->
        <!-- ========================================= -->

        <div class="text-center mt-4">

            <a asp-controller="Loja"
               asp-action="Feminino"
               class="btn btn-outline-dark px-4">

                <i class="bi bi-grid"></i>
                Ver todos os produtos femininos

            </a>

        </div>

    </section>

    
    <!-- ========================================= -->
    <!-- DIVISÃO -->
    <!-- ========================================= -->

    <hr class="my-5" />

  <!-- ========================================= -->
<!-- PROMOÇÕES -->
<!-- ========================================= -->

<section class="promocoes-section mb-5">

    <div class="text-center mb-4">

        <h2 class="fw-bold">
            🔥 Promoções
        </h2>

        <p class="text-muted">
            Aproveite nossas ofertas especiais.
        </p>

    </div>


    <!-- BOTÕES -->

        <div class="promocao-genero">

            <button type="button"
                    class="promocao-genero-btn ativo"
                    data-genero="masculino">

                Masculino

            </button>

            <button type="button"
                    class="promocao-genero-btn"
                    data-genero="feminino">

                Feminino

            </button>

        </div>


        <!-- ========================================= -->
        <!-- PROMOÇÕES MASCULINAS -->
        <!-- ========================================= -->
        @if (ViewBag.PaginasPromocoesMasculinas != null &&
            ViewBag.PaginasPromocoesMasculinas.Count > 0)
        {
            <div id="promocoesMasculinas"
                 class="promocao-genero-conteudo ativo">

                <!-- ========================================= -->
                <!-- PÁGINAS MASCULINAS -->
                <!-- ========================================= -->
                @for (int pagina = 0;
                        pagina < ViewBag.PaginasPromocoesMasculinas.Count;
                        pagina++)
                {
                    <div class="promocao-pagina @(pagina == 0 ? "" : "d-none")">

                        <div class="row g-4">

                            @foreach (var produto in ViewBag.PaginasPromocoesMasculinas[pagina])
                            {
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                                    <div class="card h-100 shadow-sm border-0 position-relative">

                                        <!-- ================================= -->
                                        <!-- BADGE DE DESCONTO -->
                                        <!-- ================================= -->
                                        @if (produto.PrecoPromocional != null &&
                                                                produto.Preco > 0)
                                        {
                                            decimal precoOriginal =
                                            Convert.ToDecimal(produto.Preco);

                                            decimal precoPromocional =
                                            Convert.ToDecimal(produto.PrecoPromocional);

                                            decimal percentualDesconto =
                                            ((precoOriginal - precoPromocional)
                                            / precoOriginal) * 100;

                                            <span class="badge bg-danger
                                                                     position-absolute
                                                                     top-0 end-0 m-2"
                                                  style="font-size: 0.9rem; z-index: 10;">

                                                @Math.Round(percentualDesconto)% OFF

                                            </span>
                                        }


                                        <!-- ================================= -->
                                        <!-- IMAGEM -->
                                        <!-- ================================= -->
                                        @if (!string.IsNullOrEmpty(produto.Imagem))
                                        {
                                            <img src="@produto.Imagem"
                                                 class="card-img-top"
                                                 style="height:280px;
                                                                    object-fit:cover;"
                                                 alt="@produto.Nome" />
                                        }
                                        else
                                        {
                                            <div class="d-flex
                                                                    align-items-center
                                                                    justify-content-center
                                                                    bg-light"
                                                 style="height:280px;">

                                                <i class="bi bi-image
                                                                      fs-1 text-muted"></i>

                                            </div>
                                        }


                                        <!-- ================================= -->
                                        <!-- INFORMAÇÕES -->
                                        <!-- ================================= -->

                                        <div class="card-body">

                                            <h5 class="fw-bold">
                                                @produto.Nome
                                            </h5>

                                            <div>

                                                <span class="text-muted
                                                                     text-decoration-line-through
                                                                     me-2">

                                                    @produto.Preco.ToString("C")

                                                </span>

                                                <span class="text-success
                                                                     fw-bold fs-5">

                                                    @produto.PrecoPromocional?.ToString("C")

                                                </span>

                                            </div>

                                            <a asp-controller="Loja"
                                               asp-action="Detalhes"
                                               asp-route-id="@produto.Id"
                                               class="btn btn-primary  promocao-btn
                                                              w-100 mt-3">

                                                Ver produto

                                            </a>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>
                }


                <!-- ========================================= -->
                <!-- SETAS + BOLINHAS MASCULINAS -->
                <!-- ========================================= -->
                @if (ViewBag.PaginasPromocoesMasculinas.Count > 1)
                {
                    <div class="text-center mt-4">

                        <button type="button"
                                id="promocaoAnterior"
                                class="btn btn-outline-secondary me-2">

                            <i class="bi bi-chevron-left"></i>

                        </button>


                        @for (int i = 0;
                                    i < ViewBag.PaginasPromocoesMasculinas.Count;
                                    i++)
                        {
                            <button type="button"
                                    class="promocao-bolinha @(i == 0 ? "ativa" : "")"
                                    data-pagina="@i">
                            </button>
                        }


                        <button type="button"
                                id="promocaoProxima"
                                class="btn btn-outline-secondary ms-2">

                            <i class="bi bi-chevron-right"></i>

                        </button>

                    </div>
                }


                <!-- ========================================= -->
                <!-- BOTÃO VER TODAS MASCULINAS -->
                <!-- ========================================= -->

                <div class="text-center mt-4">

                    <a asp-controller="Loja"
                       asp-action="Promocoes"
                       asp-route-publico="Masculino"
                       class="btn btn-outline-dark">

                        <i class="bi bi-grid"></i>

                        Ver todas masculinas

                    </a>

                </div>

            </div>
        }
        else
        {
            <p class="text-center text-muted">
                Nenhuma promoção masculina disponível.
            </p>
        }

        <!-- ========================================= -->
        <!-- PROMOÇÕES FEMININAS -->
        <!-- ========================================= -->

        <div id="promocoesFemininas" class="promocao-genero-conteudo">

            @if (ViewBag.PaginasPromocoesFemininas != null &&
                    ViewBag.PaginasPromocoesFemininas.Count > 0)
            {
                <div class="promocao-feminina-container">

                    @for (int pagina = 0;
                                pagina < Math.Min(4, ViewBag.PaginasPromocoesFemininas.Count);
                                pagina++)
                    {
                        <div class="promocao-pagina-feminina @(pagina == 0 ? "" : "d-none")">

                            <div class="row g-4">

                                @foreach (var produto in
                                                    ViewBag.PaginasPromocoesFemininas[pagina])
                                {
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                                        <div class="card h-100 shadow-sm border-0 position-relative">

                                            <!-- BADGE DE DESCONTO -->
                                            @if (produto.PrecoPromocional != null &&
                                                                        produto.Preco > 0)
                                            {
                                                decimal precoOriginal =
                                                Convert.ToDecimal(produto.Preco);

                                                decimal precoPromocional =
                                                Convert.ToDecimal(
                                                produto.PrecoPromocional);

                                                decimal percentualDesconto =
                                                ((precoOriginal -
                                                precoPromocional)
                                                / precoOriginal) * 100;

                                                <span class="badge bg-danger
                                                                         position-absolute
                                                                         top-0 end-0 m-2"
                                                      style="font-size: 0.9rem;
                                                                         z-index: 10;">

                                                    @Math.Round(percentualDesconto)% OFF

                                                </span>
                                            }


                                            <!-- IMAGEM -->
                                            @if (!string.IsNullOrEmpty(produto.Imagem))
                                            {
                                                <img src="@produto.Imagem"
                                                     class="card-img-top"
                                                     style="height:280px;
                                                                        object-fit:cover;"
                                                     alt="@produto.Nome" />
                                            }
                                            else
                                            {
                                                <div class="d-flex
                                                                        align-items-center
                                                                        justify-content-center
                                                                        bg-light"
                                                     style="height:280px;">

                                                    <i class="bi bi-image
                                                                          fs-1 text-muted"></i>

                                                </div>
                                            }


                                            <!-- INFORMAÇÕES -->

                                            <div class="card-body">

                                                <h5 class="fw-bold">
                                                    @produto.Nome
                                                </h5>


                                                <div>

                                                    <span class="text-muted
                                                                         text-decoration-line-through
                                                                         me-2">

                                                        @produto.Preco.ToString("C")

                                                    </span>


                                                    <span class="text-success
                                                                         fw-bold fs-5">

                                                        @produto.PrecoPromocional?.ToString("C")

                                                    </span>

                                                </div>


                                                <a asp-controller="Loja"
                                                   asp-action="Detalhes"
                                                   asp-route-id="@produto.Id"
                                                   class="btn btn-primary  promocao-btn
                                                                  w-100 mt-3">

                                                    Ver produto

                                                </a>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>


                <!-- ========================================= -->
                <!-- SETAS FEMININAS -->
                <!-- ========================================= -->
                @if (ViewBag.PaginasPromocoesFemininas.Count > 1)
                {
                    <div class="text-center mt-4">

                        <button type="button"
                                id="promocaoAnteriorFeminino"
                                class="btn btn-outline-secondary me-2">

                            <i class="bi bi-chevron-left"></i>

                        </button>


                        <!-- BOLINHAS -->
                        @for (int i = 0;
                                    i < Math.Min(4, ViewBag.PaginasPromocoesFemininas.Count);
                                    i++)
                        {
                            <button type="button"
                                    class="promocao-bolinha-feminino @(i == 0 ? "ativa" : "")"
                                    data-pagina="@i">
                            </button>
                        }


                        <button type="button"
                                id="promocaoProximaFeminino"
                                class="btn btn-outline-secondary ms-2">

                            <i class="bi bi-chevron-right"></i>

                        </button>

                    </div>
                }

            }
            else
            {
                <p class="text-center text-muted">
                    Nenhuma promoção feminina disponível.
                </p>
            }


            <!-- BOTÃO VER TODAS -->

            <div class="text-center mt-4">

                <a asp-controller="Loja"
                   asp-action="Promocoes"
                   asp-route-publico="Feminino"
                   class="btn btn-outline-dark">

                    <i class="bi bi-grid"></i>
                    Ver todas as promoções femininas

                </a>

            </div>

        </div>
</section>

}

<!-- ========================================= -->
<!-- CSS DOS COMBOS -->
<!-- ========================================= -->

<style>

    /* =========================================
       BANNER PRINCIPAL
       ========================================= */

    .banner-principal {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        margin-top: -25px;
        margin-bottom: 0;
        padding: 0;
    }

    .banner-carousel {
        position: relative;
        width: 100%;
        height: 420px;
        overflow: hidden;
    }
    .banner-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.6s ease;
    }

        .banner-slide.ativo {
            opacity: 1;
            visibility: visible;
        }

        .banner-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }


    /* =========================================
       SETAS
       ========================================= */

    .banner-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 45px;
        height: 45px;
        border: none;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.35);
        color: white;
        font-size: 24px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
    }

        .banner-arrow:hover {
            background: rgba(0, 0, 0, 0.6);
        }

    .banner-prev {
        left: 20px;
    }

    .banner-next {
        right: 20px;
    }


    /* =========================================
       RISCOS INDICADORES
       ========================================= */

    .banner-indicadores {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        gap: 8px;
    }

    .banner-indicador {
        width: 32px;
        height: 4px;
        padding: 0;
        border: none;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.55);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .banner-indicador.ativo {
            width: 45px;
            background: white;
        }


    /* =========================================
       TABLET
       ========================================= */

    @@media (max-width: 991px) {
        .banner-carousel

    {
        height: 350px;
    }

    }


    /* =========================================
       CELULAR
       ========================================= */

    @@media (max-width: 767px) {
        .banner-carousel

    {
        height: 260px;
    }

    .banner-arrow {
        width: 38px;
        height: 38px;
        font-size: 20px;
    }

    .banner-prev {
        left: 10px;
    }

    .banner-next {
        right: 10px;
    }

    .banner-indicadores {
        bottom: 12px;
    }

