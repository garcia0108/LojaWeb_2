@model IEnumerable<LojaWeb_2.Models.Produto>

@{
    ViewData["Title"] = ViewBag.CategoriaNome;
}

<div class="container mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            @ViewBag.CategoriaNome
        </h1>

        @if (!string.IsNullOrEmpty(ViewBag.Publico))
        {
            <p class="text-muted">
                Produtos
                @ViewBag.Publico
            </p>
        }

    </div>


    <!-- PRODUTOS -->
    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var produto in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- IMAGEM -->
                        @if (!string.IsNullOrEmpty(produto.Imagem))
                        {
                            <img src="@produto.Imagem"
                                 class="card-img-top"
                                 style="height: 280px; object-fit: cover;"
                                 alt="@produto.Nome" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 280px;">

                                <i class="bi bi-image fs-1 text-muted"></i>

                            </div>
                        }


                        <!-- INFORMAÇÕES -->

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @produto.Nome
                            </h5>


                            @if (produto.Marca != null)
                            {
                                <p class="text-muted mb-2">
                                    @produto.Marca.Nome
                                </p>
                            }


                            @if (produto.Categoria != null)
                            {
                                <span class="badge bg-light text-dark mb-3">
                                    @produto.Categoria.Nome
                                </span>
                            }


                            <!-- PREÇO -->

                            <div class="mt-auto">

                                @if (produto.EmPromocao &&
                                                        produto.PrecoPromocional.HasValue &&
                                                        produto.PrecoPromocional.Value > 0 &&
                                                        produto.PrecoPromocional.Value < produto.Preco)
                                {
                                    <div class="mb-3">

                                        <div>
                                            <span class="text-muted text-decoration-line-through">
                                                @produto.Preco.ToString("C2")
                                            </span>
                                        </div>

                                        <strong class="text-success fs-4">
                                            @produto.PrecoPromocional.Value.ToString("C2")
                                        </strong>

                                        <span class="badge bg-success ms-1">
                                            PROMOÇÃO
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <h4 class="fw-bold mb-3">
                                        @produto.Preco.ToString("C2")
                                    </h4>
                                }


                                <!-- VER PRODUTO -->

                                <a asp-controller="Loja"
                                   asp-action="Detalhes"
                                   asp-route-id="@produto.Id"
                                   class="btn btn-primary w-100">

                                    <i class="bi bi-eye"></i>
                                    Ver produto

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-box-seam fs-1 text-muted"></i>

            <h4 class="mt-3">
                Nenhum produto encontrado
            </h4>

            <p class="text-muted">
                Não existem produtos disponíveis nesta categoria.
            </p>

        </div>
    }


    <!-- VOLTAR -->

    <div class="text-center mt-5">

        @if (ViewBag.Publico == "Masculino")
        {
            <a asp-controller="Loja"
               asp-action="Masculino"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Voltar para Masculino

            </a>
        }
        else if (ViewBag.Publico == "Feminino")
        {
            <a asp-controller="Loja"
               asp-action="Feminino"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Voltar para Feminino

            </a>
        }
        else
        {
            <a asp-controller="Loja"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Voltar para a Loja

            </a>
        }

    </div>

</div>