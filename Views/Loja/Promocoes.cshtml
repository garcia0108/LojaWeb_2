    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.produto-btn:hover {
    background: #cfa34a;
    border-color: #cfa34a;
    color: #141414;

/* Botão do combo */
.promocao-card .form-adicionar-combo {
    margin-top: auto;
}

.promocao-card .form-adicionar-combo .produto-btn {
    width: 100%;
    min-height: 42px;
    border-radius: 8px;
    font-weight: 600;
}

/* Hover do botão */
.promocao-card  .form-adicionar-combo .produto-btn:hover {
    background: #cfa34a;
    border-color: #cfa34a;
    color: #141414;
}
</style>

<script>
    document.querySelectorAll(".promocao-card-clicavel").forEach(card => {

        card.addEventListener("click", function (e) {

            // Elementos que futuramente terão seus próprios cliques
            if (
                e.target.closest("button") ||
                e.target.closest("a") ||
                e.target.closest("form") ||
                e.target.closest("input") ||
                e.target.closest("select") ||
                e.target.closest("textarea") ||
                e.target.closest("label")
            ) {
                return;
            }

            const url = this.dataset.url;

            if (url) {
                window.location.href = url;
            }
        });

    });

    /* =========================================
       BOTÃO COMPRA RAPIDO
       ========================================= */
 document.querySelectorAll(".produto-tamanho.disponivel").forEach(botao => {

        botao.addEventListener("click", function (e) {

            e.stopPropagation();

            const card = this.closest(".promocao-card");

            if (!card) {
                return;
            }

            card.querySelectorAll(".produto-tamanho")
                .forEach(btn => btn.classList.remove("selecionado"));

            this.classList.add("selecionado");

            const campoTamanho =
                card.querySelector(".campo-tamanho");

            if (campoTamanho) {
                campoTamanho.value =
                    this.dataset.tamanho;
            }
        });

    });

    document.querySelectorAll(".form-compra-rapida").forEach(form => {

        form.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        form.addEventListener("submit", function (e) {

            const campoTamanho =
                this.querySelector(".campo-tamanho");

            if (!campoTamanho ||
                !campoTamanho.value) {

                e.preventDefault();

                alert("Selecione um tamanho antes de continuar.");

                return;
            }

        });

    });
</script>
    