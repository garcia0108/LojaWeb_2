@model IEnumerable<LojaWeb_2.Models.PromocaoItemViewModel>

@{
    ViewData["Title"] = "Promoções";

    var categorias =
        ViewBag.Categorias as List<LojaWeb_2.Models.Categoria>;

    var cores =
        ViewBag.Cores as List<string>;
}

<!-- ========================================= -->
<!-- FAIXA PROMOÇÃO -->
<!-- ========================================= -->

<div class="promo-faixa">

    <div class="promo-faixa-conteudo">

        <span>🔥 PROMOÇÃO RELÂMPAGO</span>
        <span>•</span>
        <span>ATÉ 40% OFF</span>
        <span>•</span>
        <span>🚚 FRETE ESPECIAL</span>
        <span>•</span>
        <span>🔥 PROMOÇÃO RELÂMPAGO</span>
        <span>•</span>
        <span>ATÉ 40% OFF</span>
        <span>•</span>
        <span>🚚 FRETE ESPECIAL</span>
        <span>•</span>
        <span>🔥 PROMOÇÃO RELÂMPAGO</span>
        <span>•</span>
        <span>ATÉ 40% OFF</span>
        <span>•</span>
        <span>🚚 FRETE ESPECIAL</span>
        <span>•</span>
        <span>🔥 PROMOÇÃO RELÂMPAGO</span>
        <span>•</span>
        <span>ATÉ 40% OFF</span>
        <span>•</span>
        <span>🚚 FRETE ESPECIAL</span>
        <span>•</span>

    </div>

</div>

<!-- ========================================= -->
<!-- BANNER PROMOÇÕES -->
<!-- ========================================= -->

<div class="promo-banner mb-5">

    <div class="promo-banner-conteudo">

        <span class="promo-banner-tag">
            OFERTAS ESPECIAIS
        </span>

        <h1>
            Ofertas que você não pode perder!
        </h1>

        <div class="promo-banner-desconto">
            <span>ATÉ</span>
            <strong>40%</strong>
            <span>OFF</span>
        </div>

        <p>
            Aproveite nossas promoções especiais
            e garanta seus produtos com preços incríveis.
        </p>

        <div class="promo-frete">
            <i class="bi bi-truck"></i>
            Frete especial para compras acima de R$ 250,00
        </div>

    </div>

</div>

<div class="container py-4">


    <!-- ========================================= -->
    <!-- PESQUISA E FILTROS -->
    <!-- ========================================= -->

    <form method="get"
          asp-action="Promocoes"
          class="mb-5">

        <div class="row g-3">


            <!-- ========================================= -->
            <!-- PESQUISA -->
            <!-- ========================================= -->

            <div class="col-md-12">

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="pesquisa"
                           value="@Context.Request.Query["pesquisa"]"
                           class="form-control"
                           placeholder="Pesquisar produto ou combo..." />

                </div>

            </div>


            <!-- ========================================= -->
            <!-- GÊNERO -->
            <!-- ========================================= -->

            <div class="col-md-2">

                <select name="publico"
                        class="form-select">

                    <option value="">
                        Gênero
                    </option>

                    <option value="Masculino"
                            selected="@(Context.Request.Query["publico"] == "Masculino")">
                        Masculino
                    </option>

                    <option value="Feminino"
                            selected="@(Context.Request.Query["publico"] == "Feminino")">
                        Feminino
                    </option>

                    <option value="Infantil"
                            selected="@(Context.Request.Query["publico"] == "Infantil")">
                        Infantil
                    </option>

                </select>

            </div>


            <!-- ========================================= -->
            <!-- CATEGORIA -->
            <!-- ========================================= -->

            <div class="col-md-2">

                <select name="categoriaId"
                        class="form-select">

                    <option value="">
                        Categoria
                    </option>

                    @if (categorias != null)
                    {
                        foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id"
                                    selected="@(Context.Request.Query["categoriaId"] == categoria.Id.ToString())">
                                @categoria.Nome
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- ========================================= -->
            <!-- COR -->
            <!-- ========================================= -->

            <div class="col-md-2">

                <select name="cor"
                        class="form-select">

                    <option value="">
                        Cor
                    </option>

                    @if (cores != null)
                    {
                        foreach (var cor in cores)
                        {
                            <option value="@cor"
                                    selected="@(Context.Request.Query["cor"] == cor)">
                                @cor
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- ========================================= -->
            <!-- TIPO -->
            <!-- ========================================= -->

            <div class="col-md-2">

                <select name="tipo"
                        class="form-select">

                    <option value="">
                        Tipo
                    </option>

                    <option value="Unitario"
                            selected="@(Context.Request.Query["tipo"] == "Unitario")">
                        Unitário
                    </option>

                    <option value="Quantidade"
                            selected="@(Context.Request.Query["tipo"] == "Quantidade")">
                        Quantidade
                    </option>

                    <option value="Combo"
                            selected="@(Context.Request.Query["tipo"] == "Combo")">
                        Combo
                    </option>

                </select>

            </div>


            <!-- ========================================= -->
            <!-- ORDENAÇÃO -->
            <!-- ========================================= -->

            <div class="col-md-2">

                <select name="ordenar"
                        class="form-select">

                    <option value="">
                        Ordenar
                    </option>

                    <option value="recentes"
                            selected="@(Context.Request.Query["ordenar"] == "recentes")">
                        Mais recentes
                    </option>

                    <option value="az"
                            selected="@(Context.Request.Query["ordenar"] == "az")">
                        Nome: A-Z
                    </option>

                    <option value="za"
                            selected="@(Context.Request.Query["ordenar"] == "za")">
                        Nome: Z-A
                    </option>

                    <option value="menor-preco"
                            selected="@(Context.Request.Query["ordenar"] == "menor-preco")">
                        Menor preço
                    </option>

                    <option value="maior-preco"
                            selected="@(Context.Request.Query["ordenar"] == "maior-preco")">
                        Maior preço
                    </option>

                </select>

            </div>


            <!-- ========================================= -->
            <!-- BOTÕES -->
            <!-- ========================================= -->

            <div class="col-md-2 d-flex gap-2">

                <button type="submit"
                        class="btn btn-dark w-100">

                    <i class="bi bi-funnel"></i>
                    Filtrar

                </button>

                <a asp-action="Promocoes"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg"></i>

                </a>

            </div>

        </div>

    </form>


    <!-- ========================================= -->
    <!-- QUANTIDADE -->
    <!-- ========================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Ofertas em Promoção
        </h3>

        <span class="text-muted">

           @ViewBag.TotalOfertas oferta(s) encontrada(s)

        </span>

    </div>


    <!-- ========================================= -->
    <!-- CATÁLOGO ÚNICO -->
    <!-- PRODUTOS + COMBOS -->
    <!-- ========================================= -->
    @if (!Model.Any())
    {
        <div class="alert alert-light text-center py-5">

            <i class="bi bi-tag fs-1 text-muted"></i>

            <h4 class="mt-3">
                Nenhuma promoção encontrada
            </h4>

            <p class="mb-0">
                Tente alterar os filtros da sua busca.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {

                <!-- ========================================= -->
                <!-- COMBO -->
                <!-- ========================================= -->
                @if (item.EhCombo)
                {
                    var combo = item.Combo;

                    if (combo != null)
                    {
                        var desconto = (int)Math.Round(
                        combo.PercentualDesconto
                        );


                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                            <div class="card promocao-card promocao-card-clicavel h-100"
                                 data-url="@Url.Action("DetalhesCombo", "Loja", new { id = combo.Id })">


                                <!-- ========================================= -->
                                <!-- IMAGEM DO COMBO -->
                                <!-- ========================================= -->

                                <div class="produto-imagem">

                                    @if (!string.IsNullOrEmpty(combo.Imagem))
                                    {
                                        <img src="@combo.Imagem"
                                             alt="@combo.Nome" />
                                    }
                                    else
                                    {
                                        <div class="sem-imagem">

                                            <i class="bi bi-box-seam"></i>

                                        </div>
                                    }


                                    <!-- ========================================= -->
                                    <!-- DESCONTO -->
                                    <!-- ========================================= -->
                                    @if (desconto > 0)
                                    {
                                        <span class="desconto-badge">

                                            @desconto% OFF

                                        </span>
                                    }


                                    <!-- ========================================= -->
                                    <!-- FRETE GRÁTIS -->
                                    <!-- ========================================= -->
                                    @if (combo.FreteGratis)
                                    {
                                        <span class="frete-gratis-badge">

                                            Frete grátis

                                        </span>
                                    }

                    </div>


                    <!-- ========================================= -->
                    <!-- INFORMAÇÕES DO COMBO -->
                    <!-- ========================================= -->

                    <div class="card-body d-flex flex-column">


                        <!-- BADGE COMBO -->

                        <div class="mb-2">

                            <span class="badge bg-primary">

                                <i class="bi bi-box-seam"></i>

                                Combo

                            </span>

                        </div>


                        <!-- NOME -->

                        <h5 class="produto-nome">

                            @combo.Nome

                        </h5>


                        <!-- QUANTIDADE -->

                        <small class="text-muted mb-2">

                            @combo.Itens.Count
                            @(combo.Itens.Count == 1
                                                    ? " produto"
                                                    : " produtos")

                    </small>

                                    <!-- AVALIAÇÕES -->

                                    <div class="combo-avaliacao mb-3">

                                        <span class="combo-estrelas">
                                            ★★★★★
                                        </span>

                                        <span class="combo-total-avaliacoes">
                                            (0)
                                        </span>

                                    </div>


                                    <!-- ========================================= -->
                                    <!-- PREÇOS -->
                                    <!-- ========================================= -->

                                    <div class="produto-precos">

                        @if (combo.ValorOriginal > combo.Preco)
                                        {
                                            <div class="preco-antigo">

                                                R$
                                                @combo.ValorOriginal.ToString("N2")

                                            </div>
                                        }

                                        <div class="preco-promocional">

                                            R$
                                            @combo.Preco.ToString("N2")

                                        </div>

                                    </div>


                                    <!-- ========================================= -->
                                    <!-- DESCRIÇÃO -->
                                    <!-- ========================================= -->
                                    @if (!string.IsNullOrWhiteSpace(combo.Descricao))
                                    {
                                        <p class="text-muted small mt-2">

                                            @combo.Descricao

                                        </p>
                                    }


                                    <!-- ========================================= -->
                                    <!-- BOTÃO -->
                                    <!-- ========================================= -->
                                    
                                    <form asp-controller="Carrinho"
                                          asp-action="AdicionarCombo"
                                          method="post"
                                          class="mt-auto form-adicionar-combo">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="comboId"
                                               value="@combo.Id" />

                                        <input type="hidden"
                                               name="quantidade"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-dark produto-btn w-100">

                                            <i class="bi bi-lightning-charge-fill me-1"></i>
                                            Compra rápida

                                        </button>

                                    </form>
                                    
                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {

                    <!-- ========================================= -->
                    <!-- PRODUTO NORMAL -->
                    <!-- ========================================= -->
                    var produto = item.Produto;

                    if (produto != null)
                    {
                        var desconto = 0;

                        if (produto.PrecoPromocional.HasValue &&
                        produto.Preco > 0)
                        {
                            desconto = (int)Math.Round(
                            (
                            (produto.Preco -
                            produto.PrecoPromocional.Value)
                            / produto.Preco
                            ) * 100
                            );
                        }


                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                            <div class="card promocao-card promocao-card-clicavel h-100"
                                 data-url="@Url.Action("Detalhes", "Loja", new { id = produto.Id })">


                                <!-- ========================================= -->
                                <!-- IMAGEM -->
                                <!-- ========================================= -->

                                <div class="produto-imagem">

                                    @if (!string.IsNullOrEmpty(item.Imagem))
                                    {
                                        <img src="@item.Imagem"
                                             alt="@produto.Nome@(item.Cor != null ? " - " + item.Cor.Nome : "")" />
                                    }
                                    else
                                    {
                                        <div class="sem-imagem">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }

                                    <!-- ========================================= -->
                                    <!-- DESCONTO -->
                                    <!-- ========================================= -->
                                    @if (desconto > 0)
                                    {
                                        <span class="desconto-badge">

                                            @desconto% OFF

                                        </span>
                                    }


                                    <!-- ========================================= -->
                                    <!-- FRETE GRÁTIS -->
                                    <!-- ========================================= -->
                                    @if (produto.TipoPromocao == "Kit" ||
                                                        produto.TipoPromocao == "Combo")
                                    {
                                        <span class="frete-gratis-badge">

                                            Frete grátis

                                        </span>
                                    }

                                </div>


                                <!-- ========================================= -->
                                <!-- INFORMAÇÕES -->
                                <!-- ========================================= -->

                                <div class="card-body d-flex flex-column">


                                    <!-- NOME -->

                                    <h5 class="produto-nome">

                                        @produto.Nome

                                    </h5>


                                    <!-- CATEGORIA -->
                                    @if (produto.Categoria != null)
                                    {
                                        <small class="text-muted mb-2">

                                            @produto.Categoria.Nome

                                        </small>
                                    }

                                    <!--COR-->
                                    @if (item.Cor != null)
                                    {
                                        <div class="produto-cor mb-2">
                                            <span class="text-muted">Cor:</span>
                                            <strong>@item.Cor.Nome</strong>
                                        </div>
                                    }

                                    <!-- ========================================= -->
                                    <!-- PREÇOS -->
                                    <!-- ========================================= -->

                                    <div class="produto-precos">

                                        <div class="preco-antigo">

                                            R$
                                            @produto.Preco.ToString("N2")

                                        </div>

                                        <div class="preco-promocional">

                                            R$
                                            @produto.PrecoPromocional?.ToString("N2")

                                        </div>

                                    </div>


                                    <!-- ========================================= -->
                                    <!-- PROMOÇÃO POR QUANTIDADE -->
                                    <!-- ========================================= -->
                                    @if (produto.TipoPromocao == "Quantidade" &&
                                                        produto.QuantidadeMinimaPromocao.HasValue &&
                                                        produto.PrecoQuantidadePromocional.HasValue)
                                    {
                                        <div class="promo-quantidade">

                                            🔥 Compre
                                            @produto.QuantidadeMinimaPromocao
                                            ou mais

                                            <br />

                                            <strong>

                                                R$
                                                @produto.PrecoQuantidadePromocional?.ToString("N2")
                                                cada

                                            </strong>

                                        </div>
                                    }


                                    <!-- ========================================= -->
                                    <!-- AVALIAÇÃO -->
                                    <!-- ========================================= -->

                                    <div class="produto-avaliacao mt-3">

                                        <span class="estrelas">
                                            ★★★★★
                                        </span>

                                        <small class="text-muted">
                                            (0)
                                        </small>

                                    </div>


                                    <!-- ========================================= -->
                                    <!-- TAMANHOS -->
                                    <!-- ========================================= -->
                                 @{
                                        var tamanhosPadrao = new[]
                                        {
                                            "PP", "P", "M", "G", "GG", "XGG"
                                        };

                                        var tamanhosDisponiveis = produto.Estoques?
                                            .Where(e =>
                                                item.Cor != null &&
                                                e.Cor == item.Cor.Nome &&
                                                e.Quantidade > 0)
                                            .Select(e => e.Tamanho)
                                            .Where(t => !string.IsNullOrWhiteSpace(t))
                                            .Distinct()
                                            .ToList()
                                            ?? new List<string>();
                                    }

                                    <div class="produto-tamanhos mt-3">

                                        @foreach (var tamanho in tamanhosPadrao)
                                        {
                                            var disponivel = tamanhosDisponiveis
                                                .Any(t => string.Equals(
                                                    t,
                                                    tamanho,
                                                    StringComparison.OrdinalIgnoreCase));

                                            <button type="button"
                                                    class="produto-tamanho @(disponivel ? "disponivel" : "indisponivel")"
                                                    data-tamanho="@tamanho"
                                                    @(disponivel ? "" : "disabled")>

                                                @tamanho

                                            </button>
                                        }

                                    </div>


                                    <!-- ========================================= -->
                                    <!-- BOTÃO -->
                                    <!-- ========================================= -->
                                    <form asp-controller="Carrinho"
                                          asp-action="CompraRapida"
                                          method="post"
                                          class="mt-auto form-compra-rapida">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="produtoId"
                                               value="@produto.Id" />

                                        <input type="hidden"
                                               name="cor"
                                               value="@(item.Cor?.Nome ?? "")"
                                               class="campo-cor" />

                                        <input type="hidden"
                                               name="tamanho"
                                               value=""
                                               class="campo-tamanho" />

                                        <input type="hidden"
                                               name="quantidade"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-dark produto-btn w-100">
                                            <i class="bi bi-lightning-charge-fill me-1"></i>
                                            Compra rápida
                                        </button>

                                    </form>
                                    
                                </div>

                            </div>

                        </div>
                    }
                }

            }

        </div>

        @if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Navegação das promoções"
         class="mt-5">

        <ul class="pagination justify-content-center">

            @* ANTERIOR *@

            <li class="page-item @(ViewBag.PaginaAtual <= 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Promocoes"
                   asp-route-publico="@Context.Request.Query["publico"]"
                   asp-route-categoriaId="@Context.Request.Query["categoriaId"]"
                   asp-route-cor="@Context.Request.Query["cor"]"
                   asp-route-tipo="@Context.Request.Query["tipo"]"
                   asp-route-pesquisa="@Context.Request.Query["pesquisa"]"
                   asp-route-ordenar="@Context.Request.Query["ordenar"]"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)">

                    <i class="bi bi-chevron-left"></i>
                    

                </a>

            </li>


            @* NÚMEROS DAS PÁGINAS *@

@{
    int paginaAtual = ViewBag.PaginaAtual;
    int totalPaginas = ViewBag.TotalPaginas;

    int inicio = Math.Max(1, paginaAtual - 2);
    int fim = Math.Min(totalPaginas, paginaAtual + 2);
}

@* PRIMEIRA PÁGINA *@

@if (inicio > 1)
{
    <li class="page-item">

        <a class="page-link"
           asp-action="Promocoes"
           asp-route-publico="@Context.Request.Query["publico"]"
           asp-route-categoriaId="@Context.Request.Query["categoriaId"]"
           asp-route-cor="@Context.Request.Query["cor"]"
           asp-route-tipo="@Context.Request.Query["tipo"]"
           asp-route-pesquisa="@Context.Request.Query["pesquisa"]"
           asp-route-ordenar="@Context.Request.Query["ordenar"]"
           asp-route-pagina="1">

            1

        </a>

    </li>

    @if (inicio > 2)
    {
        <li class="page-item disabled">

            <span class="page-link">
                ...
            </span>

        </li>
    }
}


                @* PÁGINAS PRÓXIMAS DA ATUAL *@

                @for (int i = inicio; i <= fim; i++)
                {
                    <li class="page-item @(i == paginaAtual ? "active" : "")">

                        <a class="page-link"
                           asp-action="Promocoes"
                           asp-route-publico="@Context.Request.Query["publico"]"
                           asp-route-categoriaId="@Context.Request.Query["categoriaId"]"
                           asp-route-cor="@Context.Request.Query["cor"]"
                           asp-route-tipo="@Context.Request.Query["tipo"]"
                           asp-route-pesquisa="@Context.Request.Query["pesquisa"]"
                           asp-route-ordenar="@Context.Request.Query["ordenar"]"
                           asp-route-pagina="@i">

                            @i

                        </a>

                    </li>
                }


                @* ÚLTIMA PÁGINA *@

                @if (fim < totalPaginas)
                {
                    @if (fim < totalPaginas - 1)
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                ...
                            </span>

                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Promocoes"
                           asp-route-publico="@Context.Request.Query["publico"]"
                           asp-route-categoriaId="@Context.Request.Query["categoriaId"]"
                           asp-route-cor="@Context.Request.Query["cor"]"
                           asp-route-tipo="@Context.Request.Query["tipo"]"
                           asp-route-pesquisa="@Context.Request.Query["pesquisa"]"
                           asp-route-ordenar="@Context.Request.Query["ordenar"]"
                           asp-route-pagina="@totalPaginas">

                            @totalPaginas

                        </a>

                    </li>
                }

                                @* PRÓXIMA *@

                <li class="page-item @(paginaAtual >= totalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Promocoes"
                       asp-route-publico="@Context.Request.Query["publico"]"
                       asp-route-categoriaId="@Context.Request.Query["categoriaId"]"
                       asp-route-cor="@Context.Request.Query["cor"]"
                       asp-route-tipo="@Context.Request.Query["tipo"]"
                       asp-route-pesquisa="@Context.Request.Query["pesquisa"]"
                       asp-route-ordenar="@Context.Request.Query["ordenar"]"
                       asp-route-pagina="@(paginaAtual + 1)">

                        <i class="bi bi-chevron-right"></i>

                    </a>

                </li>
        </ul>

    </nav>
}
    }

</div>

<style>
    /* =========================================
   FAIXA PROMOÇÃO
   ========================================= */

.promo-faixa {
    width: 100vw;
    height: 50px;
    margin-left: calc(50% - 50vw);
    margin-top: -24px;
    overflow: hidden;
    background: #141414;
    color: #cfa34a;
    border-top: 2px solid #cfa34a;
    border-bottom: 2px solid #cfa34a;
    padding: 9px 0;
}

.promo-faixa-conteudo {
    display: flex;
    align-items: center;
    gap: 28px;
    width: max-content;

    white-space: nowrap;

    animation: promoFaixa 25s linear infinite;
}

.promo-faixa-conteudo span {
    font-size: 17px;
    font-weight: 620;
    letter-spacing: 0.8px;
}

@@keyframes promoFaixa {

    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-30%);
    }

}

/* =========================================
   BANNER DE PROMOÇÕES
   ========================================= */

.promo-banner {
    position: relative;
    overflow: hidden;
    width: 100vw;
    
    margin-left: calc(50% - 50vw);
    
    padding: 55px 30px;

    border-radius: 16px;

    background:
        linear-gradient(
            135deg,
            #141414 0%,
            #202020 55%,
            #141414 100%
        );

    color: #fff;

    text-align: center;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

/* detalhe dourado */

.promo-banner::before {
    content: "";

    position: absolute;

    width: 200px;
