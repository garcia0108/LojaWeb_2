@model IEnumerable<LojaWeb_2.Models.Combo>

@{
    ViewData["Title"] = "Combos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam"></i>
                Combos
            </h2>

            <p class="text-muted mb-0">
                Gerencie os combos de produtos da loja.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-circle"></i>
            Novo Combo

        </a>

    </div>


    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var combo in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(combo.Imagem))
                        {
                            <img src="@combo.Imagem"
                                 class="img-fluid rounded"
                                 style="width: 100%; max-height: 350px; object-fit: contain;"
                                 alt="@combo.Nome" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 220px;">

                                <i class="bi bi-box-seam fs-1 text-muted"></i>

                            </div>
                        }


                        <div class="card-body">

                            <h5 class="fw-bold">
                                @combo.Nome
                            </h5>


                            @if (!string.IsNullOrEmpty(combo.Descricao))
                            {
                                <p class="text-muted">
                                    @combo.Descricao
                                </p>
                            }


                        <div class="mb-3">

                            <span class="badge bg-primary">

                                @combo.Itens.Count
                                @(combo.Itens.Count == 1
                                                            ? " produto"
                                                            : " produtos")

                        </span>

                        @if (combo.Ativo)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativo
                                    </span>
                                }

                            </div>


                            <h4 class="fw-bold text-success">

                                @combo.Preco.ToString("C")

                            </h4>

                        </div>


                        <div class="card-footer bg-white border-0">

                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@combo.Id"
                                   class="btn btn-warning flex-fill">

                                    <i class="bi bi-pencil"></i>
                                    Editar

                                </a>


                                <a asp-action="Details"
                                   asp-route-id="@combo.Id"
                                   class="btn btn-primary flex-fill">

                                    <i class="bi bi-eye"></i>
                                    Detalhes

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@combo.Id"
                                   class="btn btn-danger">

                                    <i class="bi bi-trash"></i>
                                   Excluir
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-box-seam fs-1 text-muted"></i>

            <h4 class="mt-3">
                Nenhum combo cadastrado
            </h4>

            <p class="text-muted">
                Crie seu primeiro combo selecionando produtos já cadastrados.
            </p>

            <a asp-action="Create"
               class="btn btn-success">

                <i class="bi bi-plus-circle"></i>
                Criar primeiro Combo

            </a>

        </div>
    }

</div>