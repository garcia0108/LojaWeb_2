@model LojaWeb_2.Models.Combo

@{
    ViewData["Title"] = "Detalhes do Combo";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-box-seam"></i>
                @Model.Nome
            </h2>

            <p class="text-muted mb-0">
                Detalhes do combo e produtos incluídos.
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil"></i>
                Editar

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Voltar

            </a>
        </div>

    </div>


    <div class="row">

        <!-- INFORMAÇÕES DO COMBO -->

        <div class="col-lg-4 mb-4">

            <div class="card shadow-sm border-0 h-100">

                @if (!string.IsNullOrEmpty(Model.Imagem))
                {
                    <img src="@Model.Imagem"
                         class="img-fluid rounded"
                         style="width: 100%; max-height: 350px; object-fit: contain;"
                         alt="@Model.Nome" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height: 280px;">

                        <i class="bi bi-box-seam fs-1 text-muted"></i>

                    </div>
                }

                <div class="card-body">

                    <h4 class="fw-bold">
                        @Model.Nome
                    </h4>

                    @if (!string.IsNullOrEmpty(Model.Descricao))
                    {
                        <p class="text-muted">
                            @Model.Descricao
                        </p>
                    }

                    <hr />

                    <p class="mb-2">
                        <strong>Preço do Combo:</strong>
                    </p>

                    <h3 class="text-success fw-bold">
                        @Model.Preco.ToString("C")
                    </h3>

                    <div class="mt-3">

                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i>
                                Ativo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-x-circle"></i>
                                Inativo
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- PRODUTOS DO COMBO -->

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-boxes"></i>
                        Produtos incluídos
                    </h5>

                </div>

                <div class="card-body p-0">

                    @if (Model.Itens.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th>Produto</th>

                                        <th class="text-center">
                                            Quantidade
                                        </th>

                                        <th class="text-end">
                                            Preço unitário
                                        </th>

                                        <th class="text-end">
                                            Subtotal
                                        </th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in Model.Itens)
                                    {
                                        var subtotal =
                                        item.Produto!.Preco *
                                        item.Quantidade;

                                        <tr>

                                            <td>

                                                <div class="d-flex align-items-center gap-3">

                                                    @if (!string.IsNullOrEmpty(item.Produto.Imagem))
                                                    {
                                                        <img src="@item.Produto.Imagem"
                                                             style="width: 55px;
                                                                                height: 55px;
                                                                                object-fit: cover;
                                                                                border-radius: 6px;"
                                                             alt="@item.Produto.Nome" />
                                                    }

                                                    <strong>
                                                        @item.Produto.Nome
                                                    </strong>

                                                </div>

                                            </td>

                                            <td class="text-center">

                                                <span class="badge bg-primary fs-6">

                                                    @item.Quantidade

                                                </span>

                                            </td>

                                            <td class="text-end">

                                                @item.Produto.Preco.ToString("C")

                                            </td>

                                            <td class="text-end fw-bold">

                                                @subtotal.ToString("C")

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                                <tfoot class="table-light">

                                    <tr>

                                        <td colspan="3"
                                            class="text-end fw-bold">

                                            Valor dos produtos:

                                        </td>

                                        <td class="text-end fw-bold">

                                            @Model.Itens.Sum(i =>
                                            i.Produto!.Preco *
                                            i.Quantidade
                                                                                ).ToString("C")

                                    </td>

                                    </tr>


                                    <tr>

                                        <td colspan="3"
                                            class="text-end fw-bold">

                                            Preço do Combo:

                                        </td>

                                        <td class="text-end text-success fw-bold fs-5">

                                            @Model.Preco.ToString("C")

                                        </td>

                                    </tr>

                                </tfoot>

                            </table>

                        </div>
                                        }
                    else
                    {
                        <div class="text-center p-5">

                            <i class="bi bi-box fs-1 text-muted"></i>

                            <p class="text-muted mt-3 mb-0">
                                Nenhum produto adicionado a este combo.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>