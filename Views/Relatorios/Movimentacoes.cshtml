@model IEnumerable<LojaWeb_2.Models.MovimentacaoEstoque>

@{
    ViewData["Title"] = "Relatório de Movimentações";
}

<div class="container mt-4">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-arrow-left-right"></i>

                Relatório de Movimentações

            </h2>

            <p class="text-muted mb-0">

                Consulte as entradas e saídas realizadas no estoque.

            </p>

        </div>

        <div class="d-flex gap-2">

            <!-- EXCEL -->

            <a asp-action="ExportarMovimentacoesExcel"
               asp-route-dataInicial="@ViewBag.DataInicial"
               asp-route-dataFinal="@ViewBag.DataFinal"
               asp-route-produtoId="@ViewBag.ProdutoId"
               asp-route-marcaId="@ViewBag.MarcaId"
               asp-route-fornecedorId="@ViewBag.FornecedorId"
               asp-route-tipo="@ViewBag.Tipo"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>
                Exportar Excel

            </a>


            <!-- PDF -->

            <a asp-action="ExportarMovimentacoesPdf"
               asp-route-dataInicial="@ViewBag.DataInicial"
               asp-route-dataFinal="@ViewBag.DataFinal"
               asp-route-produtoId="@ViewBag.ProdutoId"
               asp-route-marcaId="@ViewBag.MarcaId"
               asp-route-fornecedorId="@ViewBag.FornecedorId"
               asp-route-tipo="@ViewBag.Tipo"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                Exportar PDF

            </a>


            <!-- VOLTAR -->

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar

            </a>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- FILTROS -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-funnel"></i>

                Filtros

            </h5>


            <form asp-action="Movimentacoes" method="get">

                <div class="row g-3">


                    <!-- DATA INICIAL -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Data inicial
                        </label>

                        <input type="date"
                               name="dataInicial"
                               value="@ViewBag.DataInicial"
                               class="form-control" />

                    </div>


                    <!-- DATA FINAL -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Data final
                        </label>

                        <input type="date"
                               name="dataFinal"
                               value="@ViewBag.DataFinal"
                               class="form-control" />

                    </div>


                    <!-- PRODUTO -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Produto
                        </label>

                        <select name="produtoId"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var produto in ViewBag.Produtos)
                            {
                                if (ViewBag.ProdutoId == produto.Id)
                                {
                                    <option value="@produto.Id" selected>
                                        @produto.Nome
                                    </option>
                                }
                                else
                                {
                                    <option value="@produto.Id">
                                        @produto.Nome
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- MARCA -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Marca
                        </label>

                        <select name="marcaId"
                                class="form-select">

                            <option value="">
                                Todas
                            </option>

                            @foreach (var marca in ViewBag.Marcas)
                            {
                                if (ViewBag.MarcaId == marca.Id)
                                {
                                    <option value="@marca.Id" selected>
                                        @marca.Nome
                                    </option>
                                }
                                else
                                {
                                    <option value="@marca.Id">
                                        @marca.Nome
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- FORNECEDOR -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Fornecedor
                        </label>

                        <select name="fornecedorId"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var fornecedor in ViewBag.Fornecedores)
                            {
                                if (ViewBag.FornecedorId == fornecedor.Id)
                                {
                                    <option value="@fornecedor.Id" selected>
                                        @fornecedor.Nome
                                    </option>
                                }
                                else
                                {
                                    <option value="@fornecedor.Id">
                                        @fornecedor.Nome
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- TIPO -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select name="tipo"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @if (ViewBag.Tipo?.ToString() == "Entrada")
                            {
                                <option value="Entrada" selected>
                                    Entrada
                                </option>
                            }
                            else
                            {
                                <option value="Entrada">
                                    Entrada
                                </option>
                            }


                            @if (ViewBag.Tipo?.ToString() == "Saida")
                            {
                                <option value="Saida" selected>
                                    Saída
                                </option>
                            }
                            else
                            {
                                <option value="Saida">
                                    Saída
                                </option>
                            }

                        </select>

                    </div>


                    <!-- BOTÕES -->

                    <div class="col-md-3 d-flex align-items-end">

                        <div>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search"></i>

                                Filtrar

                            </button>


                            <a asp-action="Movimentacoes"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle"></i>

                                Limpar

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- INDICADORES -->
    <!-- ========================================= -->

    <div class="row g-3 mb-4">


        <!-- ENTRADAS -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Unidades de entrada
                    </small>

                    <h3 class="fw-bold text-success mt-2">

                        @ViewBag.TotalEntradas

                    </h3>

                    <small class="text-muted">

                        Valor:
                        @(((decimal)ViewBag.ValorEntradas).ToString("C"))

                    </small>

                </div>

            </div>

        </div>


        <!-- SAÍDAS -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Unidades de saída
                    </small>

                    <h3 class="fw-bold text-danger mt-2">

                        @ViewBag.TotalSaidas

                    </h3>

                    <small class="text-muted">

                        Valor:
                        @(((decimal)ViewBag.ValorSaidas).ToString("C"))

                    </small>

                </div>

            </div>

        </div>


        <!-- TOTAL -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total movimentado
                    </small>

                    <h3 class="fw-bold mt-2">

                        @ViewBag.TotalMovimentado

                    </h3>

                    <small class="text-muted">
                        unidades
                    </small>

                </div>

            </div>

        </div>


        <!-- MOVIMENTAÇÕES -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Registros
                    </small>

                    <h3 class="fw-bold mt-2">

                        @Model.Count()

                    </h3>

                    <small class="text-muted">
                        movimentações
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- TABELA -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Produto
                                </th>

                                <th>
                                    Marca
                                </th>

                                <th>
                                    Fornecedor
                                </th>

                                <th>
                                    Tamanho
                                </th>

                                <th>
                                    Cor
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th>
                                    Quantidade
                                </th>

                                <th>
                                    Preço de compra
                                </th>

                                <th>
                                    Observação
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- DATA -->

                                    <td>

                                        @item.Data.ToString(
                                        "dd/MM/yyyy HH:mm")

                            </td>


                            <!-- PRODUTO -->

                            <td>

                                <strong>

                                    @(item.Produto?.Nome
                                                                        ?? "Produto não encontrado")

                                </strong>

                            </td>


                            <!-- MARCA -->

                            <td>

                                @(item.Marca?.Nome
                                                                ?? "Marca não encontrada")

                            </td>


                            <!-- FORNECEDOR -->

                            <td>

                                @(item.Fornecedor?.Nome
                                                                ?? "Não informado")

                            </td>


                                    <!-- TAMANHO -->

                                    <td>

                                        <span class="badge bg-primary">

                                            @item.Tamanho

                                        </span>

                                    </td>


                                    <!-- COR -->

                                    <td>
                                        @item.Cor
                                    </td>


                                    <!-- TIPO -->

                                    <td>

                                @if (item.Tipo == TipoMovimentacao.Entrada)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-arrow-down-circle"></i>

                                                Entrada

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-arrow-up-circle"></i>

                                                Saída

                                            </span>
                                        }

                                    </td>


                                    <!-- QUANTIDADE -->

                                    <td>

                                        <strong>

                                            @item.Quantidade

                                        </strong>

                                    </td>


                                    <!-- PREÇO -->

                                    <td>

                                        @item.PrecoCompraUnitario.ToString("C")
                                        

                                    </td>


                                    <!-- OBSERVAÇÃO -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        item.Observacao))
                                        {
                                            @item.Observacao
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-arrow-left-right
                                  fs-1
                                  text-muted">
                    </i>

                    <h5 class="mt-3">

                        Nenhuma movimentação encontrada

                    </h5>

                    <p class="text-muted">

                        Não existem movimentações para
                        os filtros selecionados.

                    </p>

                </div>
            }

        </div>

    </div>

</div>