@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Relatório de Clientes";
}

<div class="container mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-people me-2"></i>

                Relatório de Clientes

            </h2>

            <p class="text-muted mb-0">
                Consulte o histórico de compras dos clientes.
            </p>

        </div>

        <div class="d-flex gap-2">

            <!-- EXPORTAR EXCEL -->
            <a asp-action="ExportarClientesExcel"
               asp-route-pesquisa="@ViewBag.Pesquisa"
               asp-route-dataInicio="@ViewBag.DataInicio"
               asp-route-dataFim="@ViewBag.DataFim"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>

                Exportar Excel

            </a>


            <!-- EXPORTAR PDF -->
            <a asp-action="ExportarClientesPdf"
               asp-route-pesquisa="@ViewBag.Pesquisa"
               asp-route-dataInicio="@ViewBag.DataInicio"
               asp-route-dataFim="@ViewBag.DataFim"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>

                Exportar PDF

            </a>


            <!-- VOLTAR -->
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Voltar

            </a>

        </div>

    </div>


    <!-- FILTROS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Clientes"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- PESQUISA -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Cliente
                        </label>

                        <input type="text"
                               name="pesquisa"
                               value="@ViewBag.Pesquisa"
                               class="form-control"
                               placeholder="Nome ou e-mail" />

                    </div>


                    <!-- DATA INICIAL -->

                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Data inicial
                        </label>

                        <input type="date"
                               name="dataInicio"
                               value="@ViewBag.DataInicio"
                               class="form-control" />

                    </div>


                    <!-- DATA FINAL -->

                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Data final
                        </label>

                        <input type="date"
                               name="dataFim"
                               value="@ViewBag.DataFim"
                               class="form-control" />

                    </div>


                    <!-- BOTÃO -->

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-fill">

                            <i class="bi bi-search me-1"></i>
                            Filtrar

                        </button>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.Pesquisa as string)
                                                || ViewBag.DataInicio != null
                                                || ViewBag.DataFim != null)
                        {
                            <a asp-action="Clientes"
                               class="btn btn-outline-secondary"
                               title="Limpar pesquisa">

                                <i class="bi bi-x-circle"></i>

                            </a>
                        }

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- RESUMO -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Clientes compradores
                    </small>

                    <h3 class="fw-bold mb-0">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Total de pedidos
                    </small>

                    <h3 class="fw-bold mb-0">

                        @Model.Sum(c => (int)c.QuantidadePedidos)

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Total comprado
                    </small>

                    <h3 class="fw-bold text-primary mb-0">

                        @Model.Sum(c => (decimal)c.TotalComprado).ToString("C")
                       

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- TABELA -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-table me-2"></i>

                Clientes

            </h5>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    E-mail
                                </th>

                                <th>
                                    Telefone
                                </th>

                                <th class="text-center">
                                    Pedidos
                                </th>

                                <th class="text-center">
                                    Itens
                                </th>

                                <th>
                                    Total comprado
                                </th>

                                <th>
                                    Última compra
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var cliente in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @cliente.Nome
                                        </strong>

                                    </td>


                                    <td>

                                        @cliente.Email

                                    </td>


                                    <td>

                                        @(cliente.Telefone ?? "-")

                                    </td>


                                    <td class="text-center">

                                        <span class="badge bg-primary">

                                            @cliente.QuantidadePedidos

                                        </span>

                                    </td>


                                    <td class="text-center">

                                        @cliente.QuantidadeItens

                                    </td>


                                    <td>

                                        <strong class="text-success">

                                            @cliente.TotalComprado.ToString("C")

                                        </strong>

                                    </td>


                                    <td>

                                        @cliente.UltimaCompra.ToString(
                                        "dd/MM/yyyy HH:mm")

                            </td>

                        </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-person-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum cliente encontrado.
                    </h5>

                    <p class="text-muted mb-0">
                        Não existem compras para os filtros selecionados.
                    </p>

                </div>
            }

        </div>

    </div>

</div>