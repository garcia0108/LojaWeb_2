@model IEnumerable<LojaWeb_2.Models.Fornecedor>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="container mt-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-truck"></i>
                Fornecedores
            </h2>

            <p class="text-muted mb-0">
                Gerencie os fornecedores da sua loja.
            </p>

        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create"
               class="btn btn-success">

                <i class="bi bi-plus-circle"></i>
                Novo Fornecedor

            </a>
        }

    </div>


    <!-- MENSAGEM -->
    @if (TempData["Sucesso"] != null)
    {
        <div id="mensagem"
             class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>
                @TempData["Sucesso"]
            </strong>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>

        </div>
    }


    <!-- PESQUISA -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="input-group">
                    
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                    <input type="text"
                           name="pesquisa"
                           value="@Context.Request.Query["pesquisa"]"
                           class="form-control"
                           placeholder="Pesquisar fornecedor, CNPJ, e-mail ou cidade..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Pesquisar

                    </button>

                    @if (!string.IsNullOrWhiteSpace(
                                        Context.Request.Query["pesquisa"]))
                    {
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle"></i>
                            Limpar

                        </a>
                    }

                </div>

            </form>

        </div>

    </div>


    <!-- TABELA -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Fornecedor
                                </th>

                                <th>
                                    CNPJ
                                </th>

                                <th>
                                    Telefone
                                </th>

                                <th>
                                    E-mail
                                </th>

                                <th>
                                    Cidade
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Ações
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- FORNECEDOR -->

                                    <td>

                                        <strong>
                                            @item.Nome
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        item.NomeFantasia))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @item.NomeFantasia
                                            </small>
                                        }

                                    </td>


                                    <!-- CNPJ -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Cnpj))
                                        {
                                            @item.Cnpj
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }

                                    </td>


                                    <!-- TELEFONE -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Telefone))
                                        {
                                            @item.Telefone
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }

                                    </td>


                                    <!-- EMAIL -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            @item.Email
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }

                                    </td>


                                    <!-- CIDADE -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Cidade))
                                        {
                                            @item.Cidade

                                            @if (!string.IsNullOrWhiteSpace(item.Estado))
                                            {
                                                <span>
                                                    / @item.Estado
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.Ativo)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>
                                                Ativo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-x-circle"></i>
                                                Inativo

                                            </span>
                                        }

                                    </td>


                                    <!-- AÇÕES -->

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Visualizar">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Editar">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Excluir">

                                                    <i class="bi bi-trash"></i>


                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-truck fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum fornecedor cadastrado
                    </h5>

                    <p class="text-muted">
                        Comece cadastrando o primeiro fornecedor.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>
                        Cadastrar Fornecedor

                    </a>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        setTimeout(function () {

            const mensagem =
                document.getElementById("mensagem");

            if (mensagem) {

                const alerta =
                    bootstrap.Alert.getOrCreateInstance(mensagem);

                alerta.close();

            }

        }, 4000);

    </script>

}
