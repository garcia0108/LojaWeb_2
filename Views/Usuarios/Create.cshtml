@model LojaWeb_2.Models.UsuarioCriarViewModel

@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-person-plus"></i>
                Novo Usuário
            </h2>

            <p class="text-muted mb-0">
                Cadastre um novo usuário no sistema.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- E-MAIL -->

                <div class="mb-4">

                    <label asp-for="Email"
                           class="form-label fw-semibold">

                        E-mail

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="usuario@email.com" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <!--USERNAME-->
                <div class="mb-4">

                    <label asp-for="UserName"
                           class="form-label fw-semibold">

                        Nome de usuário

                    </label>

                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="Ex: Cleiton" />

                    <span asp-validation-for="UserName"
                          class="text-danger">
                    </span>

                </div>


                <!-- SENHA -->

                <div class="mb-4">

                    <label asp-for="Senha"
                           class="form-label fw-semibold">

                        Senha

                    </label>

                    <input asp-for="Senha"
                           type="password"
                           class="form-control"
                           placeholder="Digite a senha" />

                    <span asp-validation-for="Senha"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Mínimo de 6 caracteres e pelo menos um número.
                    </small>

                </div>


                <!-- PERFIL -->

                <div class="mb-4">

                    <label asp-for="Perfil"
                           class="form-label fw-semibold">

                        Perfil

                    </label>

                    <select asp-for="Perfil"
                            class="form-select">

                        <option value="Funcionário">
                            Funcionário
                        </option>

                        <option value="Administrador">
                            Administrador
                        </option>

                    </select>

                    <span asp-validation-for="Perfil"
                          class="text-danger">
                    </span>

                </div>


                <!-- BOTÕES -->

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-person-plus"></i>
                        Cadastrar Usuário

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
