@model LojaWeb_2.Models.CampanhaNewsletter

@{
    ViewData["Title"] = "Detalhes da Campanha";
}

<div class="container-fluid">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Detalhes da Campanha
            </h2>

            <p class="text-muted mb-0">
                Visualize o conteúdo da campanha antes do envio.
            </p>

        </div>

        <a asp-action="Campanhas"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body p-4">

            <!-- STATUS -->

            <div class="mb-4">

                @if (Model.Enviada)
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i>
                        Enviada
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-pencil-square"></i>
                        Rascunho
                    </span>
                }

            </div>


            <!-- ASSUNTO -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Assunto
                </label>

                <div class="form-control bg-light">
                    @Model.Assunto
                </div>

            </div>


            <!-- MENSAGEM -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Mensagem
                </label>

                <div class="border rounded p-4 bg-light"
                     style="white-space: pre-line;">

                    @Model.Mensagem

                </div>

            </div>


            <!-- INFORMAÇÕES -->

            <hr />

            <div class="row mt-4">

                <div class="col-md-6 mb-3">

                    <small class="text-muted">
                        Data de criação
                    </small>

                    <div class="fw-semibold">

                        @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <small class="text-muted">
                        Data de envio
                    </small>

                    <div class="fw-semibold">

                        @if (Model.DataEnvio.HasValue)
                        {
                            @Model.DataEnvio.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Ainda não enviada
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>