@model IEnumerable<LojaWeb_2.Models.Newsletter>

@{
    ViewData["Title"] = "Newsletter";
}

<div class="container-fluid">

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success mensagem-temporaria">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger mensagem-temporaria">
            @TempData["Erro"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Newsletter
            </h2>

            <p class="text-muted mb-0">
                Gerencie os e-mails cadastrados para receber novidades.
            </p>
        </div>

    </div>


    <!-- PESQUISA -->

    <form asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">

            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por e-mail..." />

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-search"></i>
                Pesquisar

            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Limpar

            </a>

        </div>

    </form>


    <!-- TABELA -->

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                E-mail
                            </th>

                            <th>
                                Data do cadastro
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Ações
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var newsletter in Model)
                            {
                                <tr>

                                    <td>
                                        <i class="bi bi-envelope me-2"></i>

                                        @newsletter.Email
                                    </td>

                                    <td>
                                        @newsletter.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>

                                        @if (newsletter.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <!-- ATIVAR / DESATIVAR -->
                                        <form asp-action="AlternarStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@newsletter.Id" />

                                            @if (newsletter.Ativo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning"
                                                        title="Desativar inscrição">

                                                    <i class="bi bi-toggle-on"></i>
                                                    Desativar

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Ativar inscrição">

                                                    <i class="bi bi-toggle-off"></i>
                                                    Ativar

                                                </button>
                                            }

                                        </form>


                                        <!-- EXCLUIR -->
                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tem certeza que deseja excluir este e-mail?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@newsletter.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Excluir inscrição">

                                                <i class="bi bi-trash"></i>
                                                Excluir

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    Nenhum e-mail encontrado.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        setTimeout(function () {

            const mensagens = document.querySelectorAll('.mensagem-temporaria');

            mensagens.forEach(function (mensagem) {

                mensagem.style.transition = 'opacity 0.5s ease';
                mensagem.style.opacity = '0';

                setTimeout(function () {
                    mensagem.remove();
                }, 500);

            });

        }, 4000);
    </script>
}