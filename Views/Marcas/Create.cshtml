@model LojaWeb_2.Models.Marca

@{
    ViewData["Title"] = "Nova Marca";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-plus-circle"></i> Nova Marca
        </h2>

        <p class="text-muted">
            Cadastre uma nova marca para os produtos da loja.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <div class="mb-3">

                    <label asp-for="Nome" class="form-label fw-semibold">
                        Nome da Marca
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome da marca" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Descricao"
                           class="form-label fw-semibold">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="Digite uma descrição para a marca"></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Voltar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Cadastrar Marca

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}