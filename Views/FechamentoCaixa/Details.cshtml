@model LojaWeb_2.Models.FechamentoCaixa

@{
    ViewData["Title"] = "Detalhes do Caixa";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-receipt me-2"></i>
                Detalhes do Caixa
            </h2>

            <p class="text-muted mb-0">
                Consulte todas as informações da abertura e fechamento.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row g-4">

                <!-- STATUS -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Status
                    </small>

                    <div class="mt-2">

                        @if (Model.Status == StatusCaixa.Aberto)
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-unlock me-1"></i>
                                Aberto
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-lock me-1"></i>
                                Fechado
                            </span>
                        }

                    </div>

                </div>


                <!-- DATA ABERTURA -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Data de abertura
                    </small>

                    <h5 class="fw-semibold mt-2">

                        @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")

                    </h5>

                </div>


                <!-- DATA FECHAMENTO -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Data de fechamento
                    </small>

                    @if (Model.DataFechamento.HasValue)
                    {
                        <h5 class="fw-semibold mt-2">

                            @Model.DataFechamento.Value.ToString("dd/MM/yyyy HH:mm")

                        </h5>
                    }
                    else
                    {
                        <h5 class="text-muted mt-2">
                            Caixa ainda aberto
                        </h5>
                    }

                </div>


                <!-- SALDO INICIAL -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Saldo inicial
                    </small>

                    <h4 class="fw-bold mt-2">

                        @Model.SaldoInicial.ToString("C")

                    </h4>

                </div>


                <!-- ENTRADAS -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Total de entradas
                    </small>

                    <h4 class="fw-bold text-success mt-2">

                        @Model.TotalEntradas.ToString("C")

                    </h4>

                </div>


                <!-- SAÍDAS -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Total de saídas
                    </small>

                    <h4 class="fw-bold text-danger mt-2">

                        @Model.TotalSaidas.ToString("C")

                    </h4>

                </div>


                <!-- SALDO ESPERADO -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Saldo esperado
                    </small>

                    <h4 class="fw-bold text-primary mt-2">

                        @Model.SaldoEsperado.ToString("C")

                    </h4>

                </div>


                <!-- SALDO INFORMADO -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Saldo informado
                    </small>

                    @if (Model.SaldoInformado.HasValue)
                    {
                        <h4 class="fw-bold mt-2">

                            @Model.SaldoInformado.Value.ToString("C")

                        </h4>
                    }
                    else
                    {
                        <h5 class="text-muted mt-2">
                            Ainda não informado
                        </h5>
                    }

                </div>


                <!-- DIFERENÇA -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Diferença
                    </small>

                    @if (Model.Diferenca.HasValue)
                    {
                        if (Model.Diferenca.Value == 0)
                        {
                            <h4 class="fw-bold text-success mt-2">
                                R$ 0,00
                            </h4>
                        }
                        else if (Model.Diferenca.Value > 0)
                        {
                            <h4 class="fw-bold text-success mt-2">
                                + @Model.Diferenca.Value.ToString("C")
                            </h4>
                        }
                        else
                        {
                            <h4 class="fw-bold text-danger mt-2">
                                @Model.Diferenca.Value.ToString("C")
                            </h4>
                        }
                    }
                    else
                    {
                        <h5 class="text-muted mt-2">
                            —
                        </h5>
                    }

                </div>


                <!-- OBSERVAÇÃO -->

                <div class="col-12">

                    <small class="text-muted">
                        Observação
                    </small>

                    <div class="border rounded p-3 mt-2 bg-light">

                        @if (!string.IsNullOrWhiteSpace(Model.Observacao))
                        {
                            @Model.Observacao
                        }
                        else
                        {
                            <span class="text-muted">
                                Nenhuma observação informada.
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- AÇÕES -->

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                @if (Model.Status == StatusCaixa.Aberto)
                {
                    <a asp-action="Fechar"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">

                        <i class="bi bi-lock me-1"></i>
                        Fechar Caixa

                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Voltar

                </a>

            </div>

        </div>

    </div>

</div>