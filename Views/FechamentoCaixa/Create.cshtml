@model LojaWeb_2.Models.FechamentoCaixa

@{
    ViewData["Title"] = "Abrir Caixa";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-unlock me-2"></i>
                Abrir Caixa
            </h2>

            <p class="text-muted mb-0">
                Informe o saldo inicial para iniciar o caixa.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- DATA DE ABERTURA -->

                    <div class="col-md-6">

                        <label asp-for="DataAbertura"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="DataAbertura"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="DataAbertura"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SALDO INICIAL -->

                    <div class="col-md-6">

                        <label asp-for="SaldoInicial"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="SaldoInicial"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0,00" />

                        <span asp-validation-for="SaldoInicial"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Informe quanto havia disponível no caixa no momento da abertura.
                        </div>

                    </div>


                    <!-- OBSERVAÇÃO -->

                    <div class="col-12">

                        <label asp-for="Observacao"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Observacao"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Observações sobre a abertura do caixa...">
                        </textarea>

                        <span asp-validation-for="Observacao"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- INFORMAÇÕES -->

                    <div class="col-12">

                        <div class="alert alert-info">

                            <i class="bi bi-info-circle me-2"></i>

                            Ao abrir o caixa, o sistema registrará o saldo inicial.
                            As entradas e saídas serão calculadas automaticamente
                            durante o período.

                        </div>

                    </div>


                    <!-- BOTÕES -->

                    <div class="col-12 mt-3">

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-unlock me-1"></i>

                                Abrir Caixa

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}