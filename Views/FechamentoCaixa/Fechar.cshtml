@model LojaWeb_2.Models.FechamentoCaixa

@{
    ViewData["Title"] = "Fechar Caixa";
}

<div class="container mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-lock me-2"></i>

                Fechar Caixa

            </h2>

            <p class="text-muted mb-0">
                Confira os valores antes de fechar o caixa.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Voltar

        </a>

    </div>


    <!-- RESUMO -->

    <div class="row g-3 mb-4">


        <!-- SALDO INICIAL -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Saldo inicial
                    </small>

                    <h4 class="fw-bold mt-2">

                        @Model.SaldoInicial.ToString("C")

                    </h4>

                </div>

            </div>

        </div>


        <!-- ENTRADAS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total de entradas
                    </small>

                    <h4 class="fw-bold text-success mt-2">

                        @Model.TotalEntradas.ToString("C")

                    </h4>

                </div>

            </div>

        </div>


        <!-- SAÍDAS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total de saídas
                    </small>

                    <h4 class="fw-bold text-danger mt-2">

                        @Model.TotalSaidas.ToString("C")

                    </h4>

                </div>

            </div>

        </div>


        <!-- SALDO ESPERADO -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Saldo esperado
                    </small>

                    <h4 class="fw-bold text-primary mt-2">

                        @Model.SaldoEsperado.ToString("C")

                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- FORMULÁRIO -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Fechar"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />


                <!-- SALDO INFORMADO -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        <i class="bi bi-cash-stack me-1"></i>

                        Saldo encontrado no caixa

                    </label>

                    <input type="number"
                           name="saldoInformado"
                           class="form-control form-control-lg"
                           step="0.01"
                           min="0"
                           placeholder="0,00"
                           required />

                    <div class="form-text">

                        Informe o valor que realmente foi encontrado
                        no caixa.

                    </div>

                </div>


                <!-- OBSERVAÇÃO -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Observação

                    </label>

                    <textarea name="observacao"
                              class="form-control"
                              rows="4"
                              placeholder="Informe alguma observação sobre o fechamento..."></textarea>

                </div>


                <!-- ALERTA -->

                <div class="alert alert-warning">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Depois de fechar o caixa, ele será marcado como
                    <strong>Fechado</strong>.

                    Confira os valores antes de confirmar.

                </div>


                <!-- BOTÕES -->

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </a>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-lock-fill me-1"></i>

                        Fechar Caixa

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>