                                Combos

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Clientes"
                               asp-action="Index">

                                <i class="bi bi-people"></i>

                                Clientes

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Fornecedores"
                               asp-action="Index">

                                <i class="bi bi-truck"></i>

                                Fornecedores

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Categorias"
                               asp-action="Index">

                                <i class="bi bi-folder"></i>

                                Categorias

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Marcas"
                               asp-action="Index">

                                <i class="bi bi-tags"></i>

                                Marcas

                            </a>

                        </li>


                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <!-- ESTOQUE -->

                        <li>
                            <h6 class="dropdown-header">

                                <i class="bi bi-boxes"></i>

                                Estoque

                            </h6>
                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Estoque"
                               asp-action="Index">

                                <i class="bi bi-boxes"></i>

