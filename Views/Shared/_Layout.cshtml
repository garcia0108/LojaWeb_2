                                   asp-action="Index">

                                    <i class="bi bi-wallet2 me-2"></i>
                                    Contas a Pagar

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="FluxoCaixa"
                                   asp-action="Index">

                                    <i class="bi bi-arrow-left-right me-2"></i>
                                    Fluxo de Caixa

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="FechamentoCaixa"
                                   asp-action="Index">

                                    <i class="bi bi-lock me-2"></i>

                                    Fechamento de Caixa

                                </a>
                            </li>

                        }


                        @if (User.IsInRole("Administrador"))
                        {

                            <li>
                                <hr class="dropdown-divider">
                            </li>


                            <!-- ADMINISTRAÇÃO -->

                            <li>
                                <h6 class="dropdown-header">

                                    <i class="bi bi-gear"></i>

                                    Administração

                                </h6>
                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Usuarios"
                                   asp-action="Index">

                                    <i class="bi bi-people"></i>

                                    Usuários

                                </a>

                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <h6 class="dropdown-header">

                                    <i class="bi bi-envelope"></i>

                                    Campanhas/Promoções

                                </h6>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Newsletters"
                                   asp-action="Campanhas">

                                    <i class="bi bi-megaphone"></i>
                                    Campanhas

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Newsletters"
                                   asp-action="Index">

                                    <i class="bi bi-people"></i>
                                    Lista de Clientes

                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="ConfiguracaoLoja"
                                   asp-action="Index">

                                    <i class="bi bi-gear me-2"></i>

                                    Configurações

                                </a>
                            </li>

                        }

                    </ul>

                </div>
            }


            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                

                @await Component.InvokeAsync("ConfiguracaoLoja")

            </a>


            <!-- ================================================= -->
            <!-- BOTÃO MOBILE -->
            <!-- ================================================= -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- ================================================= -->
            <!-- MENU PRINCIPAL -->
            <!-- ================================================= -->

            <div class="collapse navbar-collapse" id="menu">

                <!-- MENU CENTRAL -->
                <ul class="navbar-nav menu-central mx-auto">

                    <!-- INÍCIO -->
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house"></i>
                            Início

                        </a>
                    </li>


                    <!-- LOJA -->
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           asp-controller="Loja"
                           asp-action="Index">

                            <i class="bi bi-shop"></i>
                            Loja

                        </a>
                    </li>


                    <!-- PROMOÇÕES -->
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           asp-controller="Loja"
                           asp-action="Promocoes">

                            <i class="bi bi-tag"></i>
                            Promoções

                        </a>
                    </li>>


                    <!-- NOVIDADES -->
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           href="#">

                            <i class="bi bi-stars"></i>
                            Novidades

                        </a>
                    </li>


                    <!-- CONTATO -->
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           href="#">

                            <i class="bi bi-envelope"></i>
                            Contato

                        </a>
                    </li>

                </ul>


                <!-- ÁREA DIREITA -->
                <div class="d-flex align-items-center menu-direita">

                    <!-- CARRINHO -->
                    <a class="nav-link menu-link me-3"
                        asp-controller="Carrinho"
                       asp-action="Index">
                      

                        <i class="bi bi-cart3"></i>

                        <span class="carrinho-badge">
                            @quantidadeCarrinho
                        </span>

                    </a>


                    <!-- ================================================= -->
                    <!-- MENU DA CONTA -->
                    <!-- ================================================= -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown ms-3">

                            <button class="btn btn-dark border-0 dropdown-toggle d-flex align-items-center"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="bi bi-person-circle me-2 fs-5"></i>

                                <span>
                                    Olá, @User.Identity.Name
                                </span>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end shadow">

                                <!-- MINHA CONTA -->
                                <li>
                                    <h6 class="dropdown-header">

                                        <i class="bi bi-person me-2"></i>

                                        Minha Contao

                                    </h6>
                                   
                                </li>

                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <!-- MEUS DADOS -->
                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="MinhaConta"
                                       asp-action="Index">

                                        <i class="bi bi-person-vcard me-2"></i>

                                        Meus Dados

                                    </a>

                                </li>


                                <!-- MEUS PEDIDOS - SOMENTE CLIENTE -->
                                @if (User.IsInRole("Cliente"))
                                {
                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="MinhaConta"
                                           asp-action="Pedidos">

                                            <i class="bi bi-box-seam me-2"></i>

                                            Meus Pedidos

                                        </a>

                                    </li>
                                }


                                <li>
                                    <hr class="dropdown-divider">
                                </li>


                                <!-- SAIR -->
                                <li>

                                    <form class="px-2"
                                          asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home")">

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Sair

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>
                    }
                    else
                    {
                        <!-- VISITANTE NÃO LOGADO -->

                        <div class="dropdown ms-3">

                            <button class="btn btn-dark border-0 dropdown-toggle d-flex align-items-center"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="bi bi-person-circle me-2 fs-5"></i>

                               

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end shadow">

