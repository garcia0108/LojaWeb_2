                            </h6>
                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Vendas"
                               asp-action="Index">

                                <i class="bi bi-cart3"></i>

                                Vendas

                            </a>

                        </li>


                        @if (User.IsInRole("Administrador"))
                        {

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Vendas"
                                   asp-action="Dashboard">

                                    <i class="bi bi-speedometer2"></i>

