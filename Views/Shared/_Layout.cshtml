                                <i class="bi bi-folder2-open"></i>

                                Cadastros

                            </h6>
                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-controller="Produtos"
                               asp-action="Index">

                                <i class="bi bi-box"></i>

                                Produtos

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Combos"
                               asp-action="Index">

