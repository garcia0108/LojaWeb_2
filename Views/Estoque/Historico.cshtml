@model IEnumerable<LojaWeb_2.Models.MovimentacaoEstoque>

@{
    ViewData["Title"] = "Histórico de Estoque";
}

<!--CABEÇALHO-->

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-clock-history"></i>
                Histórico de Estoque
            </h2>

            <p class="text-muted mb-0">
                Consulte todas as entradas e saídas realizadas.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>

    <!-- FILTROS -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="mb-3">

            <h5 class="fw-bold mb-1">

                <i class="bi bi-funnel"></i>
                Filtros

            </h5>

            <small class="text-muted">
                Filtre as movimentações do estoque.
            </small>

        </div>


        <form asp-action="Historico"
              method="get">

            <div class="row">

                <!-- DATA INICIAL -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Data inicial
                    </label>

                    <input type="date"
                           name="dataInicial"
                           value="@ViewBag.DataInicial"
                           class="form-control" />

                </div>


                <!-- DATA FINAL -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Data final
                    </label>

                    <input type="date"
                           name="dataFinal"
                           value="@ViewBag.DataFinal"
                           class="form-control" />

                </div>


                <!-- PRODUTO -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Produto
                    </label>

                    <select name="produtoId"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @foreach (var produto in ViewBag.Produtos)
                        {
                            <option value="@produto.Id"
                                    selected="@(ViewBag.ProdutoId == produto.Id)">
                                @produto.Nome
                            </option>
                        }

                    </select>

                </div>


                <!-- MARCA -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Marca
                    </label>

                    <select name="marcaId"
                            class="form-select">

                        <option value="">
                            Todas
                        </option>

                        @foreach (var marca in ViewBag.Marcas)
                        {
                            <option value="@marca.Id"
                                    selected="@(ViewBag.MarcaId == marca.Id)">
                                @marca.Nome
                            </option>
                        }

                    </select>

                </div>


                <!-- TIPO -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Tipo
                    </label>

                    <select name="tipo"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="@TipoMovimentacao.Entrada"
                                selected="@(ViewBag.Tipo == TipoMovimentacao.Entrada)">
                            Entrada
                        </option>

                        <option value="@TipoMovimentacao.Saida"
                                selected="@(ViewBag.Tipo == TipoMovimentacao.Saida)">
                            Saída
                        </option>

                    </select>

                </div>

            </div>


            <!-- BOTÕES -->

            <div class="d-flex justify-content-end gap-2 mt-2">

                <a asp-action="Historico"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle"></i>
                    Limpar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search"></i>
                    Filtrar

                </button>

            </div>

        </form>

    </div>

</div>

    <!--CARDS DA TABELA-->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Data</th>

                                <th>Tipo</th>

                                <th>Produto</th>

                                <th>Fornecedor</th>

                                <th>Marca</th>

                                <th>Tamanho</th>

                                <th>Cor</th>

                                <th>Quantidade</th>

                                <th>Custo unitário</th>

                                <th>Custo total</th>

                                <th>Observação</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Data.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>

                                        @if (item.Tipo ==
                                                                        TipoMovimentacao.Entrada)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-arrow-down-circle"></i>
                                                Entrada

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-arrow-up-circle"></i>
                                                Saída

                                            </span>
                                        }

                                    </td>

                                    <td>
                                        <strong>
                                            @item.Produto?.Nome
                                        </strong>
                                    </td>

                                    <td>
                                        @if (item.Fornecedor != null)
                                        {
                                            @item.Fornecedor.Nome
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.Marca?.Nome
                                    </td>

                                    <td>
                                        @item.Tamanho
                                    </td>

                                    <td>
                                        @item.Cor
                                    </td>

                                    <td>

                                        @if (item.Tipo ==
                                                                        TipoMovimentacao.Entrada)
                                        {
                                            <strong class="text-success">
                                                +@item.Quantidade
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-danger">
                                                -@item.Quantidade
                                            </strong>
                                        }

                                    </td>

                                    <!-- CUSTO UNITÁRIO -->

                                    <td>

                                        @if (item.PrecoCompraUnitario > 0)
                                        {
                                            <span class="fw-semibold">
                                                @item.PrecoCompraUnitario.ToString("C2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- CUSTO TOTAL -->
                                    <!-- CUSTO TOTAL -->

                                    <td>

                                        @if (item.PrecoCompraUnitario > 0)
                                        {
                                            var custoTotal =
                                            item.Quantidade *
                                            item.PrecoCompraUnitario;

                                            <strong class="text-primary">
                                                @custoTotal.ToString("C2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.Observacao
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-clock-history fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhuma movimentação registrada
                    </h5>

                    <p class="text-muted">
                        As próximas entradas e saídas aparecerão aqui.
                    </p>

                </div>
            }

        </div>

    </div>

</div>