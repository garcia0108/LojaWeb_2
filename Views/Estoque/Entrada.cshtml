@model LojaWeb_2.Models.Estoque

@{
    ViewData["Title"] = "Entrada de Estoque";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-box-arrow-in-down"></i>
                Entrada de Estoque
            </h2>

            <p class="text-muted mb-0">
                Registre a entrada de produtos no estoque.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Entrada"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- PRODUTO -->
                <div class="mb-4">

                    <label asp-for="ProdutoId"
                           class="form-label fw-semibold">

                        Produto

                    </label>

                    <select asp-for="ProdutoId"
                            asp-items="ViewBag.Produtos"
                            class="form-select">

                        <option value="">
                            Selecione um produto
                        </option>

                    </select>

                    <span asp-validation-for="ProdutoId"
                          class="text-danger">
                    </span>

                </div>

                <!-- MARCA -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Marca
                    </label>

                    <select asp-for="MarcaId"
                            asp-items="ViewBag.Marcas"
                            class="form-select">

                        <option value="">
                            Selecione uma marca
                        </option>

                    </select>

                    <span asp-validation-for="MarcaId"
                          class="text-danger">
                    </span>

                </div>

                <!-- FORNECEDOR -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Fornecedor
                    </label>

                    <select name="fornecedorId"
                            class="form-select"
                            asp-items="ViewBag.Fornecedores">

                        <option value="">
                            Selecione um fornecedor
                        </option>

                    </select>

                    <span class="text-danger">
                        @Html.ValidationMessage("fornecedorId")
                    </span>

                </div>


                <!-- TAMANHO / COR -->
                <div class="row">

                    <!-- TAMANHO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Tamanho"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Tamanho"
                                class="form-select">

                            <option value="">
                                Selecione o tamanho
                            </option>

                            <option value="PP">PP</option>
                            <option value="P">P</option>
                            <option value="M">M</option>
                            <option value="G">G</option>
                            <option value="GG">GG</option>
                            <option value="XG">XG</option>

                        </select>

                        <span asp-validation-for="Tamanho"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- COR -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Cor"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Cor"
                               class="form-control"
                               placeholder="Ex: Preto" />

                        <span asp-validation-for="Cor"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- QUANTIDADE -->
                <div class="mb-4">

                    <label asp-for="Quantidade"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Quantidade"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Informe a quantidade" />

                    <span asp-validation-for="Quantidade"
                          class="text-danger">
                    </span>

                </div>

                <!--PREÇO DE COMPRA-->
                <div class="mb-3">

                    <label class="form-label">
                        Preço de compra unitário
                    </label>

                    <input type="text"
                           name="precoCompraUnitario"
                           class="form-control"
                           inputmode="decimal"
                           placeholder="Ex: 69,90"
                           autocomplete="off" />

                    <span class="text-danger">
                        @Html.ValidationMessage("precoCompraUnitario")
                    </span>

                </div>

                <!-- BOTÕES -->
                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>
                        Registrar Entrada

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}