@model IEnumerable<LojaWeb_2.Models.Estoque>

@{
    ViewData["Title"] = "Controle de Estoque";
}

<div class="container mt-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-boxes"></i>
                Controle de Estoque
            </h2>

            <p class="text-muted mb-0">
                Consulte e gerencie o estoque dos produtos.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Entrada"
               class="btn btn-success">

                <i class="bi bi-plus-circle"></i>
                Entrada

            </a>

            <a asp-action="Saida"
               class="btn btn-danger">

                <i class="bi bi-dash-circle"></i>
                Saída

            </a>

            <a asp-action="Historico"
               class="btn btn-outline-secondary">

                <i class="bi bi-clock-history"></i>
                Histórico

            </a>
            
        </div>

    </div>


    <!-- MENSAGEM -->
    @if (TempData["Sucesso"] != null)
    {
        <div id="mensagem"
             class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>
                @TempData["Sucesso"]
            </strong>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>

        </div>
    }

    <!-- INDICADORES -->

    <div class="row g-3 mb-4">

        <!-- PRODUTOS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Produtos
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalProdutos
                            </h3>

                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- UNIDADES -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total de unidades
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalUnidades
                            </h3>

                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-boxes"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ESTOQUE BAIXO -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Estoque baixo
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.EstoqueBaixo
                            </h3>

                        </div>

                        <div class="fs-1 text-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ESGOTADOS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Esgotados
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.Esgotados
                            </h3>

                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-x-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ALERTAS DE ESTOQUE -->

    <div class="row g-4 mb-4">

        <!-- ESTOQUE BAIXO -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold text-warning mb-3">

                        <i class="bi bi-exclamation-triangle"></i>

                        Estoque baixo

                    </h5>

                    @if (ViewBag.ProdutosEstoqueBaixo != null &&
                                        ViewBag.ProdutosEstoqueBaixo.Count > 0)
                    {
                        <div class="table-responsive">

                            <table class="table table-sm align-middle mb-0">

                                <thead>

                                    <tr>
                                        <th>Produto</th>
                                        <th>Marca</th>
                                        <th>Tamanho</th>
                                        <th>Cor</th>
                                        <th class="text-end">Qtd.</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item
                                                                    in ViewBag.ProdutosEstoqueBaixo)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @item.Produto?.Nome
                                                </strong>
                                            </td>

                                            <td>
                                                @if (item.Marca != null)
                                                {
                                                    @item.Marca.Nome
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Sem marca
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @item.Tamanho
                                            </td>

                                            <td>
                                                @item.Cor
                                            </td>

                                            <td class="text-end">

                                                <span class="badge bg-warning text-dark">
                                                    @item.Quantidade
                                                </span>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-check-circle fs-1 text-success"></i>

                            <p class="text-muted mt-2 mb-0">
                                Nenhum produto com estoque baixo.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ESGOTADOS -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold text-danger mb-3">

                        <i class="bi bi-x-circle"></i>

                        Produtos esgotados

                    </h5>

                    @if (ViewBag.ProdutosEsgotados != null &&
                                        ViewBag.ProdutosEsgotados.Count > 0)
                    {
                        <div class="table-responsive">

                            <table class="table table-sm align-middle mb-0">

                                <thead>

                                    <tr>
                                        <th>Produto</th>
                                        <th>Marca</th>
                                        <th>Tamanho</th>
                                        <th>Cor</th>
                                        <th class="text-end">Status</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item
                                                                    in ViewBag.ProdutosEsgotados)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @item.Produto?.Nome
                                                </strong>
                                            </td>

                                            <td>
                                                @if (item.Marca != null)
                                                {
                                                    @item.Marca.Nome
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Sem marca
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @item.Tamanho
                                            </td>

                                            <td>
                                                @item.Cor
                                            </td>

                                            <td class="text-end">

                                                <span class="badge bg-danger">
                                                    Esgotado
                                                </span>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-check-circle fs-1 text-success"></i>

                            <p class="text-muted mt-2 mb-0">
                                Nenhum produto esgotado.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

 <!-- FILTROS -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="mb-3">

            <h5 class="fw-bold mb-1">

                <i class="bi bi-funnel"></i>
                Filtros

            </h5>

            <small class="text-muted">
                Pesquise e filtre os produtos do estoque.
            </small>

        </div>


        <form asp-action="Index"
              method="get">

            <!-- PESQUISA GERAL -->

            <div class="row">

                <div class="col-md-10 mb-3">

                    <label class="form-label fw-semibold">
                        Pesquisa
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-search"></i>

                        </span>

                        <input type="text"
                               name="pesquisa"
                               value="@Context.Request.Query["pesquisa"]"
                               class="form-control"
                               placeholder="Pesquisar produto, marca, tamanho ou cor..." />

                    </div>

                </div>

            </div>


            <!-- FILTROS ESPECÍFICOS -->

            <div class="row">

                <!-- PRODUTO -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Produto
                    </label>

                    <select name="produtoId"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @foreach (var produto in ViewBag.Produtos)
                        {
                            <option value="@produto.Id"
                                    selected="@(ViewBag.ProdutoId == produto.Id)">
                                @produto.Nome
                            </option>
                        }

                    </select>

                </div>


                <!-- MARCA -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Marca
                    </label>

                    <select name="marcaId"
                            class="form-select">

                        <option value="">
                            Todas
                        </option>

                        @foreach (var marca in ViewBag.Marcas)
                        {
                            <option value="@marca.Id"
                                    selected="@(ViewBag.MarcaId == marca.Id)">
                                @marca.Nome
                            </option>
                        }

                    </select>

                </div>


                <!-- TAMANHO -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Tamanho
                    </label>

                    <select name="tamanho"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @foreach (var tamanho in ViewBag.Tamanhos)
                        {
                            <option value="@tamanho"
                                    selected="@(ViewBag.Tamanho == tamanho)">
                                @tamanho
                            </option>
                        }

                    </select>

                </div>


                <!-- COR -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Cor
                    </label>

                    <select name="cor"
                            class="form-select">

                        <option value="">
                            Todas
                        </option>

                        @foreach (var cor in ViewBag.Cores)
                        {
                            <option value="@cor"
                                    selected="@(ViewBag.Cor == cor)">
                                @cor
                            </option>
                        }

                    </select>

                </div>


                <!-- SITUAÇÃO -->

                <div class="col-md-3 mb-3">

                    <label class="form-label fw-semibold">
                        Situação
                    </label>

                    <select name="situacao"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="EmEstoque"
                                selected="@(ViewBag.Situacao == "EmEstoque")">
                            Em estoque
                        </option>

                        <option value="EstoqueBaixo"
                                selected="@(ViewBag.Situacao == "EstoqueBaixo")">
                            Estoque baixo
                        </option>

                        <option value="Esgotado"
                                selected="@(ViewBag.Situacao == "Esgotado")">
                            Esgotado
                        </option>

                    </select>

                </div>

            </div>


            <!-- BOTÕES -->

            <div class="d-flex justify-content-end gap-2 mt-2">

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle"></i>
                    Limpar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search"></i>
                    Filtrar

                </button>

            </div>

        </form>

    </div>

</div>


    <!-- TABELA -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Produto
                                </th>

                                <th>
                                    Marca
                                </th>

                                <th>
                                    Tamanho
                                </th>

                                <th>
                                    Cor
                                </th>

                                <th>
                                    Quantidade
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- PRODUTO -->
                                    <td>

                                        <strong>
                                            @item.Produto?.Nome
                                        </strong>

                                    </td>


                                    <!-- MARCA -->
                                    <td>

                                        @if (item.Marca != null)
                                        {
                                            @item.Marca.Nome
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sem marca
                                            </span>
                                        }

                                    </td>


                                    <!-- TAMANHO -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.Tamanho))
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Tamanho
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- COR -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.Cor))
                                        {
                                            @item.Cor
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- QUANTIDADE -->
                                    <td>

                                        <strong>
                                            @item.Quantidade
                                        </strong>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (item.Quantidade == 0)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle"></i>
                                                Esgotado

                                            </span>
                                        }
                                        else if (item.Quantidade <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-exclamation-triangle"></i>
                                                Baixo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>
                                                Disponível

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum item encontrado
                    </h5>

                    <p class="text-muted">
                        Não existem produtos correspondentes à pesquisa.
                    </p>

                    <a asp-action="Entrada"
                       class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>
                        Registrar Entrada

                    </a>

                </div>
            }

        </div>

    </div>

</div>

<!-- ÚLTIMAS MOVIMENTAÇÕES -->

<div class="card shadow-sm border-0 mt-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h5 class="fw-bold mb-1">

                    <i class="bi bi-clock-history"></i>
                    Últimas movimentações

                </h5>

                <p class="text-muted mb-0">
                    Últimas entradas e saídas registradas.
                </p>

            </div>

            <a asp-action="Historico"
               class="btn btn-outline-secondary btn-sm">

                <i class="bi bi-list-ul"></i>
                Ver histórico completo

            </a>

        </div>


        @if (ViewBag.UltimasMovimentacoes != null &&
                ViewBag.UltimasMovimentacoes.Count > 0)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Data
                            </th>

                            <th>
                                Tipo
                            </th>

                            <th>
                                Produto
                            </th>

                            <th>
                                Marca
                            </th>

                            <th>
                                Fornecedor
                            </th>

                            <th>
                                Quantidade
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var movimentacao
                                            in ViewBag.UltimasMovimentacoes)
                        {
                            <tr>

                                <!-- DATA -->

                                <td>

                                    @movimentacao.Data.ToString(
                                    "dd/MM/yyyy HH:mm")

                        </td>


                        <!-- TIPO -->

                        <td>

                            @if (movimentacao.Tipo
                                                        == TipoMovimentacao.Entrada)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-arrow-down-circle"></i>
                                            Entrada

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-arrow-up-circle"></i>
                                            Saída

                                        </span>
                                    }

                                </td>


                                <!-- PRODUTO -->

                                <td>

                                    <strong>
                                        @movimentacao.Produto?.Nome
                                    </strong>

                                </td>

                                <!--MARCA-->
                                <td>
                                    @if (movimentacao.Marca != null)
                                    {
                                        @movimentacao.Marca.Nome
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <!-- FORNECEDOR -->

                                <td>

                                    @if (movimentacao.Fornecedor != null)
                                    {
                                        @movimentacao.Fornecedor.Nome
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- QUANTIDADE -->

                                <td>

                                    @if (movimentacao.Tipo
                                                                == TipoMovimentacao.Entrada)
                                    {
                                        <span class="text-success fw-bold">

                                            +@movimentacao.Quantidade

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">

                                            -@movimentacao.Quantidade

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-4">

                <i class="bi bi-clock-history fs-1 text-muted"></i>

                <p class="text-muted mt-2 mb-0">
                    Nenhuma movimentação registrada.
                </p>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        setTimeout(function () {

            const mensagem =
                document.getElementById("mensagem");

            if (mensagem) {

                const alerta =
                    bootstrap.Alert.getOrCreateInstance(mensagem);

                alerta.close();

            }

        }, 4000);

    </script>

}