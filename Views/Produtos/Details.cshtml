@model LojaWeb_2.Models.Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-eye"></i>
                Detalhes do Produto
            </h2>

            <p class="text-muted mb-0">
                Visualize todas as informações do produto.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- ========================================= -->
                <!-- GALERIA DE IMAGENS -->
                <!-- ========================================= -->

                <div class="col-md-4 text-center">

                    <!-- IMAGEM PRINCIPAL -->
                    <div class="mb-3">

                        @if (!string.IsNullOrEmpty(Model.Imagem))
                        {
                            <img id="imagemPrincipal"
                                 src="@Model.Imagem"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-height: 400px;
                            width: 100%;
                            object-fit: contain;"
                                 alt="@Model.Nome" />
                        }
                        else
                        {
                            <div class="border rounded p-5 text-muted">

                                <i class="bi bi-image fs-1"></i>

                                <p class="mt-2 mb-0">
                                    Sem imagem principal
                                </p>

                            </div>
                        }

                    </div>


                    <!-- ========================================= -->
                    <!-- IMAGENS PRINCIPAIS -->
                    <!-- ========================================= -->
                    @if (Model.Imagens != null && Model.Imagens.Any())
                    {
                        <h6 class="fw-bold mt-3 mb-2">
                            Imagens do produto
                        </h6>

                        <div class="d-flex flex-wrap gap-2 justify-content-center">

                            @foreach (var imagem in Model.Imagens)
                            {
                                <img src="@imagem.Caminho"
                                     class="img-thumbnail imagem-miniatura"
                                     style="width: 70px;
                                    height: 70px;
                                    object-fit: cover;
                                    cursor: pointer;"
                                     alt="@Model.Nome"
                                     onclick="trocarImagem('@imagem.Caminho')" />
                            }

                        </div>
                    }


                    <!-- ========================================= -->
                    <!-- CORES E IMAGENS -->
                    <!-- ========================================= -->
                    @if (Model.Cores != null && Model.Cores.Any())
                    {
                        <hr class="my-4" />

                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-palette me-2"></i>
                            Cores e imagens
                        </h5>

                        @foreach (var cor in Model.Cores)
                        {
                            <div class="card border mb-3 text-start">

                                <div class="card-body">

                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-circle-fill me-2"></i>
                                        @cor.Nome
                                    </h6>


                                    @if (cor.Imagens != null && cor.Imagens.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">

                                            @foreach (var imagem in cor.Imagens)
                                            {
                                                <img src="@imagem.Caminho"
                                                     class="img-thumbnail"
                                                     style="width: 75px;
                                                            height: 75px;
                                                            object-fit: cover;
                                                            cursor: pointer;"
                                                     alt="@cor.Nome"
                                                     onclick="trocarImagem('@imagem.Caminho')" />
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Nenhuma imagem cadastrada para esta cor.
                                        </span>
                                    }

                                </div>

                            </div>
                        }
                    }

                </div>


                <!-- INFORMAÇÕES -->
                <div class="col-md-8">

                    <table class="table table-bordered align-middle">

                        <tr>
                            <th style="width: 180px;">
                                Nome
                            </th>

                            <td>
                                <strong>
                                    @Model.Nome
                                </strong>
                            </td>
                        </tr>


                        <tr>
                            <th>
                                Categoria
                            </th>

                            <td>

                                @if (Model.Categoria != null)
                                {
                                    @Model.Categoria.Nome
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem categoria
                                    </span>
                                }

                            </td>
                        </tr>


                        <tr>
                            <th>
                                Marca
                            </th>

                            <td>

                                @if (Model.Marca != null)
                                {
                                    @Model.Marca.Nome
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem marca
                                    </span>
                                }

                            </td>
                        </tr>

                        <tr>
                            <th>
                                Fornecedor
                            </th>

                            <td>

                                @if (Model.Fornecedor != null)
                                {
                                    @Model.Fornecedor.Nome
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem fornecedor
                                    </span>
                                }

                            </td>
                        </tr>

                        <tr>
                            <th>
                                Preço
                            </th>

                            <td>

                                @if (Model.EmPromocao &&
                                                                Model.PrecoPromocional.HasValue &&
                                                                Model.PrecoPromocional.Value > 0 &&
                                                                Model.PrecoPromocional.Value < Model.Preco)
                                {
                                    <div>

                                        <!-- PREÇO ORIGINAL -->

                                        <div>
                                            <span class="text-muted text-decoration-line-through">
                                                @Model.Preco.ToString("C2")
                                            </span>
                                        </div>

                                        <!-- PREÇO PROMOCIONAL -->

                                        <div>
                                            <strong class="text-success fs-4">

                                                @Model.PrecoPromocional.Value.ToString("C2")

                                            </strong>

                                            <span class="badge bg-success ms-2">
                                                PROMOÇÃO
                                            </span>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <strong class="text-success fs-5">

                                        @Model.Preco.ToString("C2")

                                    </strong>
                                }

                            </td>
                        </tr>


                        <tr>
                            <th>
                                Tamanho
                            </th>

                            <td>
                                @if (!string.IsNullOrEmpty(Model.Tamanho))
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Tamanho
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Não informado
                                    </span>
                                }
                            </td>
                        </tr>


                        <tr>
                            <th>
                                Cores
                            </th>

                            <td>

                                @if (Model.Cores != null && Model.Cores.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2">

                                        @foreach (var cor in Model.Cores)
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                @cor.Nome
                                            </span>
                                        }

                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(Model.Cor))
                                {
                                    <span class="badge bg-secondary fs-6">
                                        @Model.Cor
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Não informada
                                    </span>
                                }

                            </td>
                        </tr>


                        <tr>
                            <th>
                                Descrição
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                                {
                                    @Model.Descricao
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem descrição
                                    </span>
                                }

                            </td>
                        </tr>


                        <tr>
                            <th>
                                Status
                            </th>

                            <td>

                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i>
                                        Inativo
                                    </span>
                                }

                            </td>
                        </tr>

                    </table>


                    <!-- BOTÕES -->
                    <div class="d-flex gap-2 mt-4">

                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-warning">

                                <i class="bi bi-pencil"></i>
                                Editar

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-danger">

                                <i class="bi bi-trash"></i>
                                Excluir

                            </a>
                        }

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left"></i>
                            Voltar

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    function trocarImagem(caminho) {

        document.getElementById("imagemPrincipal").src = caminho;

    }
</script>