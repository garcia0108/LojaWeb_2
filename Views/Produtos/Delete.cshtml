@model LojaWeb_2.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Exclusão bloqueada!</strong><br />
        @TempData["Erro"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger">
                <i class="bi bi-trash"></i>
                Excluir Produto
            </h2>

            <p class="text-muted mb-0">
                Confirme a exclusão do produto.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <!-- AVISO -->

    <div class="alert alert-danger" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        <strong>Atenção!</strong>

        Esta ação não poderá ser desfeita.
        O produto será removido do sistema.

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- IMAGEM -->

                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.Imagem))
                    {
                        <img src="@Model.Imagem"
                             class="img-fluid rounded shadow-sm"
                             style="max-height: 300px; object-fit: contain;"
                             alt="@Model.Nome" />
                    }
                    else
                    {
                        <div class="border rounded p-5 text-muted">

                            <i class="bi bi-image fs-1"></i>

                            <p class="mt-2 mb-0">
                                Sem imagem
                            </p>

                        </div>
                    }

                </div>


                <!-- INFORMAÇÕES -->

                <div class="col-md-8">

                    <h4 class="fw-bold mb-4">
                        @Model.Nome
                    </h4>


                    <table class="table table-bordered align-middle">

                        <tr>

                            <th style="width: 180px;">
                                Categoria
                            </th>

                            <td>

                                @if (Model.Categoria != null)
                                {
                                    @Model.Categoria.Nome
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem categoria
                                    </span>
                                }

                            </td>

                        </tr>


                        <tr>

                            <th>
                                Marca
                            </th>

                            <td>

                                @if (Model.Marca != null)
                                {
                                    @Model.Marca.Nome
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sem marca
                                    </span>
                                }

                            </td>

                        </tr>


                        <tr>

                            <th>
                                Preço
                            </th>

                            <td>

                                <strong>
                                    @Model.Preco.ToString("C")
                                </strong>

                            </td>

                        </tr>


                        <tr>

                            <th>
                                Tamanho
                            </th>

                            <td>
                                @Model.Tamanho
                            </td>

                        </tr>


                        <tr>

                            <th>
                                Cor
                            </th>

                            <td>
                                @Model.Cor
                            </td>

                        </tr>


                        <tr>

                            <th>
                                Status
                            </th>

                            <td>

                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativo
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>


                    <!-- FORMULÁRIO DE EXCLUSÃO -->

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash"></i>
                                Sim, excluir produto

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle"></i>
                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    setTimeout(function () {
        const alertaErro = document.querySelector('.alert-danger');

        if (alertaErro) {
            alertaErro.classList.remove('show');

            setTimeout(function () {
                alertaErro.remove();
            }, 500);
        }
    }, 5000);
</script>