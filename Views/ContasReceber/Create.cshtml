@model LojaWeb_2.Models.ContaReceber

@{
    ViewData["Title"] = "Nova Conta a Receber";
}

<div class="container mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-plus-circle me-2"></i>

                Nova Conta a Receber

            </h2>

            <p class="text-muted mb-0">
                Cadastre um valor que a loja tem para receber.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Voltar

        </a>

    </div>


    <!-- FORMULÁRIO -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ERROS -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">


                    <!-- DESCRIÇÃO -->

                    <div class="col-md-8">

                        <label asp-for="Descricao"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Descricao"
                               class="form-control"
                               placeholder="Ex.: Venda no cartão de crédito" />

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- VALOR -->

                    <div class="col-md-4">

                        <label asp-for="Valor"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Valor"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="0,00" />

                        <span asp-validation-for="Valor"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- VENCIMENTO -->

                    <div class="col-md-4">

                        <label asp-for="DataVencimento"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="DataVencimento"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="DataVencimento"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- FORMA DE PAGAMENTO -->

                    <div class="col-md-4">

                        <label asp-for="FormaPagamento"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="FormaPagamento"
                                class="form-select">

                            <option value="">
                                Selecione
                            </option>

                            <option value="Dinheiro">
                                Dinheiro
                            </option>

                            <option value="Pix">
                                Pix
                            </option>

                            <option value="Cartão de Débito">
                                Cartão de Débito
                            </option>

                            <option value="Cartão de Crédito">
                                Cartão de Crédito
                            </option>

                            <option value="Boleto">
                                Boleto
                            </option>

                            <option value="Transferência">
                                Transferência
                            </option>

                            <option value="Outro">
                                Outro
                            </option>

                        </select>

                        <span asp-validation-for="FormaPagamento"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- VENDA -->

                    <div class="col-md-4">

                        <label asp-for="VendaId"
                               class="form-label fw-semibold">
                            Venda relacionada
                        </label>

                        <input asp-for="VendaId"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Ex.: 125" />

                        <div class="form-text">
                            Opcional. Informe o número da venda, se houver.
                        </div>

                        <span asp-validation-for="VendaId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- OBSERVAÇÃO -->

                    <div class="col-12">

                        <label asp-for="Observacao"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Observacao"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Observações sobre o recebimento...">
                        </textarea>

                        <span asp-validation-for="Observacao"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BOTÕES -->

                    <div class="col-12 mt-4">

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Salvar conta

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}