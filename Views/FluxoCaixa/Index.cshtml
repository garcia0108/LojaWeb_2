@model IEnumerable<LojaWeb_2.Models.LancamentoFinanceiro>

@{
    ViewData["Title"] = "Fluxo de Caixa";

    decimal entradas = ViewBag.Entradas ?? 0m;
    decimal saidas = ViewBag.Saidas ?? 0m;
    decimal saldo = ViewBag.Saldo ?? 0m;

    DateTime dataInicial = ViewBag.DataInicial;
    DateTime dataFinal = ViewBag.DataFinal;
}

<div class="container-fluid mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-arrow-left-right me-2"></i>

                Fluxo de Caixa

            </h2>

            <p class="text-muted mb-0">

                Acompanhe as entradas e saídas financeiras da loja.

            </p>

        </div>


        <a asp-controller="Financeiro"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Financeiro

        </a>

    </div>


    <!-- FILTRO DE PERÍODO -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Data inicial
                        </label>

                        <input type="date"
                               name="dataInicial"
                               value="@dataInicial.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Data final
                        </label>

                        <input type="date"
                               name="dataFinal"
                               value="@dataFinal.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                Filtrar

                            </button>


                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Limpar

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- RESUMO -->

    <div class="row g-3 mb-4">


        <!-- ENTRADAS -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Entradas
                            </small>

                            <h3 class="fw-bold text-success mt-2">

                                @entradas.ToString("C")

                            </h3>

                        </div>


                        <div class="fs-1 text-success">

                            <i class="bi bi-arrow-down-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SAÍDAS -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Saídas
                            </small>

                            <h3 class="fw-bold text-danger mt-2">

                                @saidas.ToString("C")

                            </h3>

                        </div>


                        <div class="fs-1 text-danger">

                            <i class="bi bi-arrow-up-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SALDO -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Saldo do período
                            </small>

                            <h3 class="fw-bold mt-2
                                @(saldo >= 0
                                                                    ? "text-primary"
                                                                    : "text-danger")">

                                @saldo.ToString("C")

                            </h3>

                        </div>


                        <div class="fs-1 text-primary">

                            <i class="bi bi-wallet2"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- TABELA -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-list-ul me-2"></i>

                    Movimentações do período

                </h5>

                <span class="text-muted">

                    @Model.Count() lançamento(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Descrição
                                </th>

                                <th>
                                    Categoria
                                </th>

                                <th>
                                    Forma de pagamento
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th class="text-end">
                                    Valor
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        @item.Data.ToString(
                                        "dd/MM/yyyy HH:mm")

                            </td>


                            <td>

                                <strong>
                                    @item.Descricao
                                </strong>

                            </td>


                            <td>

                                @item.Categoria

                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                                                item.FormaPagamento))
                                        {
                                            @item.FormaPagamento
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.Tipo ==
                                                                        TipoLancamentoFinanceiro.Receita)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-arrow-down me-1"></i>

                                                Entrada

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-arrow-up me-1"></i>

                                                Saída

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end fw-bold">

                                        @if (item.Tipo ==
                                                                        TipoLancamentoFinanceiro.Receita)
                                        {
                                            <span class="text-success">

                                                + @item.Valor.ToString("C")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                - @item.Valor.ToString("C")

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-cash-stack fs-1 text-muted"></i>

                    <h5 class="mt-3">

                        Nenhuma movimentação encontrada.

                    </h5>

                    <p class="text-muted mb-0">

                        Não existem lançamentos pagos neste período.

                    </p>

                </div>
            }

        </div>

    </div>

</div>