@model LojaWeb_2.Models.Modelagem

@{
    ViewData["Title"] = "Duplicar Modelagem";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-copy me-2"></i>Duplicar Modelagem
            </h2>

            <small class="text-muted">
                Crie uma nova modelagem copiando todas as medidas da atual.
            </small>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>

    </div>

    <form asp-controller="Modelagens"
      asp-action="Duplicar"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

        <div class="row g-4">

            <!-- Card esquerdo -->
            <div class="col-lg-4">

                <div class="card shadow-sm border-0 rounded-4 h-100">

                    <div class="card-body text-center">

                        @if (Model.ModoIlustracao == "Imagem"
                        && !string.IsNullOrEmpty(Model.ImagemReferencia))
                        {
                            <img src="@Model.ImagemReferencia"
                                 class="img-fluid rounded-3 shadow-sm mb-3"
                                 style="max-height:320px;" />
                        }
                        else
                        {
                            @await Html.PartialAsync("~/Views/Shared/Modelagens/_SvgBase.cshtml")
                        }

                        <div class="alert alert-info mt-3 mb-0">

                            <i class="bi bi-info-circle me-1"></i>

                            Todas as medidas serão copiadas.

                        </div>

                    </div>

                </div>

            </div>

            <!-- Card direito -->
            <div class="col-lg-8">

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row g-3">

                            <!-- Marca -->

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Nova Marca
                                </label>

                                <select asp-for="MarcaId"
                                        asp-items="ViewBag.MarcaId"
                                        class="form-select">
                                </select>

                            </div>

                            <!-- Categoria -->

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Nova Categoria
                                </label>

                                <select asp-for="CategoriaId"
                                        asp-items="ViewBag.CategoriaId"
                                        class="form-select">
                                </select>

                            </div>

                            <!-- Nome -->

                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Nome da Nova Modelagem
                                </label>

                                <input asp-for="Nome"
                                       class="form-control"/>

                            </div>

                        </div>

                        <hr class="my-4">

                        <hr class="my-4">

                        <!--AREA DO CHECKEBOX-->
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-sliders me-2"></i>
                            Opções da Cópia
                        </h5>

                        <div class="border rounded-3 p-3 bg-light">

                            <div class="form-check mb-2">

                                <input type="hidden" name="copiarSomentePreenchidos" value="false" />
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="copiarSomentePreenchidos"
                                       name="copiarSomentePreenchidos"
                                       value="true"
                                       checked />

                                <label class="form-check-label" for="copiarSomentePreenchidos">
                                    Copiar apenas tamanhos preenchidos
                                </label>

                            </div>

                            <div class="form-check mb-2">

                                <input type="hidden" name="copiarImagem" value="false" />
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="copiarImagem"
                                       name="copiarImagem"
                                       value="true"
                                       checked />

                                <label class="form-check-label" for="copiarImagem">
                                    Copiar imagem de referência
                                </label>

                            </div>

                            <div class="form-check">

                               <input type="hidden" name="manterTipoIlustracao" value="false" />
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="manterTipoIlustracao"
                                       name="manterTipoIlustracao"
                                       value="true"
                                       checked />

                                <label class="form-check-label" for="manterTipoIlustracao">
                                    Manter tipo de ilustração
                                </label>

                            </div>

                        </div>

                        <h5 class="fw-bold mb-3">

                            <i class="bi bi-rulers me-2"></i>

                            Medidas que serão copiadas

                        </h5>

                        <div class="table-responsive">

                            <table class="table table-bordered text-center align-middle">

                                <thead class="table-dark">

                                    <tr>

                                        <th>Tamanho</th>

                                        <th>A</th>

                                        <th>B</th>

                                        <th>C</th>

                                        <th>D</th>

                                        <th>E</th>

                                        <th>F</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in Model.Medidas.OrderBy(x => x.Id))
                                    {
                                        bool possuiMedidas =
                                            item.Torax > 0 ||
                                            item.Comprimento > 0 ||
                                            item.Barra > 0 ||
                                            item.Ombro > 0 ||
                                            item.ComprimentoManga > 0 ||
                                            item.AberturaManga > 0;

                                         if (!possuiMedidas)
                                            {
                                                continue;
                                            }
                                       
                                        <tr>
                                            <td class="fw-semibold">@item.Tamanho</td>
                                            <td>@item.Torax</td>
                                            <td>@item.Comprimento</td>
                                            <td>@item.Barra</td>
                                            <td>@item.Ombro</td>
                                            <td>@item.ComprimentoManga</td>
                                            <td>@item.AberturaManga</td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0 rounded-bottom-4">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancelar

                            </a>

                           <button type="submit" class="btn btn-success">
                                <i class="bi bi-copy"></i>
                                Criar Cópia
                           </button>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}