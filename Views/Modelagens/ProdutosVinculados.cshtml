@model LojaWeb_2.Models.Modelagem

@{
    ViewData["Title"] = "Produtos Vinculados";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-box-seam me-2"></i>
                Produtos Vinculados
            </h2>

            <small class="text-muted">
                @Model.Marca?.Nome • @Model.Categoria?.Nome • @Model.Nome
            </small>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>

    </div>

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body">

            @if (Model.Produtos != null && Model.Produtos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Produto</th>
                                <th>Marca</th>
                                <th>Categoria</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var produto in Model.Produtos.OrderBy(p => p.Nome))
                            {
                                <tr>

                                    <td>
                                        <strong>@produto.Nome</strong>
                                    </td>

                                    <td>@produto.Marca?.Nome</td>

                                    <td>@produto.Categoria?.Nome</td>

                                    <td class="text-center">

                                        @if (produto.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inativo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="Produtos"
                                           asp-action="Details"
                                           asp-route-id="@produto.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>

                                            Ver Produto

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-box fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum produto vinculado
                    </h5>

                    <p class="text-muted mb-0">
                        Esta modelagem ainda não está sendo utilizada por nenhum produto.
                    </p>

                </div>
            }

        </div>

    </div>

</div>