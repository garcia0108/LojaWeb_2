@model LojaWeb_2.Models.Venda

@{
    ViewData["Title"] = $"Venda #{Model.Id}";
}

<div class="container mt-4">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-receipt"></i>

                Venda #@Model.Id

            </h2>

            <p class="text-muted mb-0">
                Detalhes da venda realizada.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Voltar

        </a>

    </div>


    <!-- INFORMAÇÕES DA VENDA -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <!-- CLIENTE -->

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Cliente
                    </small>

                    <div class="fw-semibold">

                        <i class="bi bi-person"></i>

                        @(Model.Cliente?.Nome ?? "Cliente não encontrado")

                    </div>

                </div>


                <!-- DATA -->

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Data da venda
                    </small>

                    <div class="fw-semibold">

                        <i class="bi bi-calendar"></i>

                        @Model.DataVenda.ToString("dd/MM/yyyy HH:mm")

                    </div>

                </div>


                <!-- PAGAMENTO -->

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Forma de pagamento
                    </small>

                    <div class="fw-semibold">

                        <i class="bi bi-credit-card"></i>

                        @Model.FormaPagamento

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-4">

                    <small class="text-muted">
                        Status
                    </small>

                    <div>

                        @if (Model.Status == "Concluída")
                        {
                            <span class="badge bg-success">

                                <i class="bi bi-check-circle"></i>

                                Concluída

                            </span>
                        }
                        else if (Model.Status == "Cancelada")
                        {
                            <span class="badge bg-danger">

                                <i class="bi bi-x-circle"></i>

                                Cancelada

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">

                                @Model.Status

                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ITENS -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-cart3"></i>

                    Produtos da venda

                </h5>

                <span class="badge bg-primary">

                    @Model.Itens.Count
                    @(Model.Itens.Count == 1 ? "item" : "itens")

                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Produto
                            </th>

                            <th>
                                Marca
                            </th>

                            <th>
                                Tamanho
                            </th>

                            <th>
                                Cor
                            </th>

                            <th>
                                Quantidade
                            </th>

                            <th>
                                Preço unitário
                            </th>

                            <th>
                                Custo unitário
                            </th>

                            <th>
                                Subtotal
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Itens)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @(item.Produto?.Nome ?? "Produto não encontrado")
                                    </strong>

                                </td>

                                <td>
                                    @(item.Marca?.Nome ?? "—")
                                </td>

                                <td>
                                    @item.Tamanho
                                </td>

                                <td>
                                    @item.Cor
                                </td>

                                <td>
                                    @item.Quantidade
                                </td>

                                <td>
                                    @item.PrecoUnitario.ToString("C2")
                                </td>

                                <td>
                                    @item.CustoUnitario.ToString("C2")
                                </td>

                                <td>

                                    <strong>
                                        @item.Subtotal.ToString("C2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

                <!-- RESUMO FINANCEIRO -->

                <div class="row justify-content-end mt-4">

                    <!-- CUSTO TOTAL -->

                    <div class="col-md-3 mb-3">

                        <div class="card border-0 bg-light h-100">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Custo da mercadoria
                                </small>

                                <div class="fs-4 fw-bold text-danger">

                                    @(((decimal)ViewBag.CustoTotal).ToString("C2"))

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- LUCRO BRUTO -->

                    <div class="col-md-3 mb-3">

                        <div class="card border-0 bg-light h-100">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Lucro bruto
                                </small>

                                <div class="fs-4 fw-bold text-success">

                                    @(((decimal)ViewBag.LucroBruto).ToString("C2"))

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- MARGEM -->

                    <div class="col-md-3 mb-3">

                        <div class="card border-0 bg-light h-100">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Margem de lucro
                                </small>

                                <div class="fs-4 fw-bold text-primary">

                                    @(((decimal)ViewBag.MargemLucro).ToString("N2"))%

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- TOTAL DA VENDA -->

                    <div class="col-md-3 mb-3">

                        <div class="card border-0 bg-light h-100">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Total da venda
                                </small>

                                <div class="fs-3 fw-bold text-success">

                                    @Model.Total.ToString("C2")

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- AÇÕES -->

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Voltar

        </a>

    <a asp-action="AlterarStatus"
       asp-route-id="@Model.Id"
       class="btn btn-primary">

        <i class="bi bi-arrow-repeat me-1"></i>

        Alterar status

    </a>

        @if (Model.Status == "Concluída")
        {
            <form asp-action="Cancelar"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Tem certeza que deseja cancelar esta venda? O estoque será devolvido.');">

                    <i class="bi bi-x-circle"></i>

                    Cancelar Venda

                </button>

            </form>
        }

    </div>

</div>