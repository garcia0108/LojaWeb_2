@model LojaWeb_2.Models.RelatorioFinanceiroViewModel

@{
    ViewData["Title"] = "Relatório Financeiro";
}

<div class="container-fluid mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-file-earmark-bar-graph me-2"></i>

                Relatório Financeiro

            </h2>

            <p class="text-muted mb-0">

                Consulte as receitas, despesas e resultados financeiros.

            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Relatorios"
               asp-action="ExportarFinanceiroExcel"
               asp-route-dataInicio="@Model.DataInicio.ToString("yyyy-MM-dd")"
               asp-route-dataFim="@Model.DataFim.ToString("yyyy-MM-dd")"
               asp-route-tipo="@Model.Tipo"
               asp-route-status="@Model.Status"
               asp-route-formaPagamento="@Model.FormaPagamento"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>
                Excel

            </a>


            <a asp-controller="Relatorios"
               asp-action="ExportarFinanceiroPdf"
               asp-route-dataInicio="@Model.DataInicio.ToString("yyyy-MM-dd")"
               asp-route-dataFim="@Model.DataFim.ToString("yyyy-MM-dd")"
               asp-route-tipo="@Model.Tipo"
               asp-route-status="@Model.Status"
               asp-route-formaPagamento="@Model.FormaPagamento"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>

                PDF

            </a>


            <a asp-controller="Financeiro"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Financeiro

            </a>

        </div>
        
    </div>


    <!-- FILTROS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <!-- PRIMEIRA LINHA -->

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Data inicial
                        </label>

                        <input type="date"
                               name="dataInicio"
                               value="@Model.DataInicio.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Data final
                        </label>

                        <input type="date"
                               name="dataFim"
                               value="@Model.DataFim.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select name="tipo"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @if (Model.Tipo ==
                                                        TipoLancamentoFinanceiro.Receita)
                            {
                                <option value="1" selected>
                                    Receita
                                </option>
                            }
                            else
                            {
                                <option value="1">
                                    Receita
                                </option>
                            }


                            @if (Model.Tipo ==
                                                        TipoLancamentoFinanceiro.Despesa)
                            {
                                <option value="2" selected>
                                    Despesa
                                </option>
                            }
                            else
                            {
                                <option value="2">
                                    Despesa
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @if (Model.Status ==
                                                        StatusLancamentoFinanceiro.Pago)
                            {
                                <option value="2" selected>
                                    Pago
                                </option>
                            }
                            else
                            {
                                <option value="2">
                                    Pago
                                </option>
                            }


                            @if (Model.Status ==
                                                        StatusLancamentoFinanceiro.Pendente)
                            {
                                <option value="1" selected>
                                    Pendente
                                </option>
                            }
                            else
                            {
                                <option value="1">
                                    Pendente
                                </option>
                            }


                            @if (Model.Status ==
                                                        StatusLancamentoFinanceiro.Cancelado)
                            {
                                <option value="3" selected>
                                    Cancelado
                                </option>
                            }
                            else
                            {
                                <option value="3">
                                    Cancelado
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <!-- SEGUNDA LINHA -->

                <div class="row g-3 mt-1 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Forma de pagamento
                        </label>

                        <select name="formaPagamento" class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var forma in Model.FormasPagamento)
                            {
                                <option value="@forma"
                                        selected="@(Model.FormaPagamento == forma)">
                                    @forma
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-6">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                Filtrar

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Limpar

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- RESUMO -->

    <div class="row g-4 mb-4">


        <!-- RECEITAS -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Total de receitas
                            </small>

                            <h3 class="fw-bold text-success mt-2">

                                @Model.TotalReceitas.ToString("C")

                            </h3>

                            <small class="text-muted">

                                @Model.QuantidadeReceitas lançamento(s)

                            </small>

                        </div>


                        <i class="bi bi-arrow-down-circle fs-2 text-success"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- DESPESAS -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Total de despesas
                            </small>

                            <h3 class="fw-bold text-danger mt-2">

                                @Model.TotalDespesas.ToString("C")

                            </h3>

                            <small class="text-muted">

                                @Model.QuantidadeDespesas lançamento(s)

                            </small>

                        </div>


                        <i class="bi bi-arrow-up-circle fs-2 text-danger"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- SALDO -->

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Saldo do período
                            </small>

                            <h3 class="fw-bold mt-2
                                @(Model.Saldo >= 0
                                                                    ? "text-primary"
                                                                    : "text-danger")">

                                @Model.Saldo.ToString("C")

                            </h3>

                            <small class="text-muted">

                                Receitas - Despesas

                            </small>

                        </div>


                        <i class="bi bi-wallet2 fs-2 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PERÍODO -->

    <div class="alert alert-light border shadow-sm mb-4">

        <i class="bi bi-calendar3 me-2"></i>

        <strong>Período:</strong>

        @Model.DataInicio.ToString("dd/MM/yyyy")
        até
        @Model.DataFim.ToString("dd/MM/yyyy")

    </div>


    <!-- LANÇAMENTOS -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-list-ul me-2"></i>

                    Lançamentos do período

                </h5>


                <span class="text-muted">

                    @Model.Lancamentos.Count lançamento(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Lancamentos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Descrição
                                </th>

                                <th>
                                    Categoria
                                </th>

                                <th>
                                    Forma de pagamento
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Valor
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.Lancamentos)
                            {
                                <tr>

                                    <td>

                                        @item.Data.ToString(
                                        "dd/MM/yyyy HH:mm")

                            </td>


                            <td>

                                <strong>
                                    @item.Descricao
                                </strong>

                            </td>


                            <td>

                                @item.Categoria

                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                                                item.FormaPagamento))
                                        {
                                            @item.FormaPagamento
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.Tipo ==
                                                                        TipoLancamentoFinanceiro.Receita)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-arrow-down me-1"></i>

                                                Receita

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-arrow-up me-1"></i>

                                                Despesa

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.Status ==
                                                                        StatusLancamentoFinanceiro.Pago)
                                        {
                                            <span class="badge bg-success">
                                                Pago
                                            </span>
                                        }
                                        else if (item.Status ==
                                        StatusLancamentoFinanceiro.Pendente)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pendente
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelado
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end fw-bold">

                                        @if (item.Tipo ==
                                                                        TipoLancamentoFinanceiro.Receita)
                                        {
                                            <span class="text-success">

                                                + @item.Valor.ToString("C")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                - @item.Valor.ToString("C")

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-x fs-1 text-muted"></i>

                    <h5 class="mt-3">

                        Nenhum lançamento encontrado.

                    </h5>

                    <p class="text-muted mb-0">

                        Não existem lançamentos no período selecionado.

                    </p>

                </div>
            }

        </div>

    </div>

</div>