@model IEnumerable<LojaWeb_2.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<!--CABEÇALHO-->

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📂 Categorias</h2>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nova Categoria
            </a>
        }
    </div>

    <!--MENSAGENS DE ALERTAS-->

    @if(TempData["Sucesso"] != null)
    {
        <div id="mensagemSucesso" class="alert alert-success">
            @TempData["Sucesso"]
        </div>
        <script>
            setTimeout(function(){
                document.getElementById("mensagemSucesso").style.display = "none";
            }, 3000); 
        </script>
    }

    @if (TempData["Erro"] != null)
    {
        <div id="mensagemErro" class="alert alert-danger">
            @TempData["Erro"]
        </div>
        <script>
            setTimeout(function(){
                document.getElementById("mensagemErro").style.display = "none";
            }, 3000);
        </script>
    } 

    <!-- PESQUISA -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="pesquisa"
                           value="@ViewBag.Pesquisa"
                           class="form-control"
                           placeholder="Digite o nome da categoria..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Pesquisar

                    </button>

                    @if (!string.IsNullOrWhiteSpace(
                                        Context.Request.Query["pesquisa"]))
                    {
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle"></i>
                            Limpar

                        </a>
                    }

                </div>

            </form>

        </div>

    </div>

    <!--TABELAS-->
    <table class="table table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- IMAGEM -->

                        <td>
                            @if (!string.IsNullOrEmpty(item.Imagem))
                            {
                                <img src="@item.Imagem"
                                     alt="@item.Nome"
                                     style="width: 70px;
                                    height: 70px;
                                    object-fit: cover;
                                    border-radius: 8px;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light"
                                     style="width: 70px;
                                    height: 70px;
                                    border-radius: 8px;">

                                    <i class="bi bi-image text-muted"></i>

                                </div>
                            }
                        </td>


                        <!-- NOME -->

                        <td>
                            @item.Nome
                        </td>


                        <!-- DESCRIÇÃO -->

                        <td>
                            @item.Descricao
                        </td>

                        <td class="text-end">

                            <div class="btn-group">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info"
                                   title="Visualizar">

                                    <i class="bi bi-eye"></i>

                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Editar">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Excluir">

                                        <i class="bi bi-trash"></i>

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="3">

                        <div class="text-center py-5">

                            <i class="bi bi-search fs-1 text-muted"></i>

                            <h5 class="mt-3 fw-bold">
                                Nenhuma categoria encontrada
                            </h5>

                            <p class="text-muted">
                                Não encontramos categorias para a pesquisa realizada.
                            </p>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle"></i>
                                Limpar pesquisa

                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

