@model LojaWeb_2.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-person-plus"></i>
                Novo Cliente
            </h2>

            <p class="text-muted mb-0">
                Cadastre um novo cliente na LojaWeb.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- DADOS PRINCIPAIS -->

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-person"></i>
                    Dados do cliente
                </h5>

                <div class="row">

                    <!-- NOME -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Nome"
                               class="form-label fw-semibold">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Digite o nome do cliente" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CPF/CNPJ -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="CpfCnpj"
                               class="form-label fw-semibold">
                            CPF/CNPJ
                        </label>

                        <input asp-for="CpfCnpj"
                               class="form-control"
                               placeholder="Digite o CPF ou CNPJ" />

                        <span asp-validation-for="CpfCnpj"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- E-MAIL -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="cliente@email.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TELEFONE -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefone"
                               class="form-label fw-semibold">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="form-control"
                               placeholder="(47) 99999-9999" />

                        <span asp-validation-for="Telefone"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- ENDEREÇO -->

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-geo-alt"></i>
                    Endereço
                </h5>

                <div class="row">

                    <!-- ENDEREÇO -->

                    <div class="col-md-8 mb-3">

                        <label asp-for="Endereco"
                               class="form-label fw-semibold">
                            Endereço
                        </label>

                        <input asp-for="Endereco"
                               class="form-control"
                               placeholder="Rua, avenida, etc." />

                        <span asp-validation-for="Endereco"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- NÚMERO -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Numero"
                               class="form-label fw-semibold">
                            Número
                        </label>

                        <input asp-for="Numero"
                               class="form-control"
                               placeholder="Número" />

                        <span asp-validation-for="Numero"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BAIRRO -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Bairro"
                               class="form-label fw-semibold">
                            Bairro
                        </label>

                        <input asp-for="Bairro"
                               class="form-control"
                               placeholder="Bairro" />

                        <span asp-validation-for="Bairro"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CIDADE -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Cidade"
                               class="form-label fw-semibold">
                            Cidade
                        </label>

                        <input asp-for="Cidade"
                               class="form-control"
                               placeholder="Cidade" />

                        <span asp-validation-for="Cidade"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ESTADO -->

                    <div class="col-md-2 mb-3">

                        <label asp-for="Estado"
                               class="form-label fw-semibold">
                            Estado
                        </label>

                        <input asp-for="Estado"
                               class="form-control"
                               placeholder="SC"
                               maxlength="2" />

                        <span asp-validation-for="Estado"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CEP -->

                    <div class="col-md-2 mb-3">

                        <label asp-for="Cep"
                               class="form-label fw-semibold">
                            CEP
                        </label>

                        <input asp-for="Cep"
                               class="form-control"
                               placeholder="CEP" />

                        <span asp-validation-for="Cep"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- BOTÕES -->

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle"></i>
                        Cadastrar Cliente

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}