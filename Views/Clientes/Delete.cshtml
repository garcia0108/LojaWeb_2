@model LojaWeb_2.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger">
                <i class="bi bi-trash"></i>
                Excluir Cliente
            </h2>

            <p class="text-muted mb-0">
                Confirme a exclusão do cliente.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <strong>Atenção!</strong>

                Você está prestes a excluir este cliente.
                Essa ação não poderá ser desfeita.

            </div>


            <!-- CLIENTE -->

            <div class="text-center mb-4">

                <i class="bi bi-person-circle fs-1 text-muted"></i>

                <h4 class="fw-bold mt-2">
                    @Model.Nome
                </h4>

                @if (Model.Ativo)
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i>
                        Ativo
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        <i class="bi bi-x-circle"></i>
                        Inativo
                    </span>
                }

            </div>


            <hr />


            <!-- DADOS -->

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        CPF/CNPJ
                    </label>

                    <div class="form-control bg-light">

                        @(string.IsNullOrWhiteSpace(Model.CpfCnpj)
                                                ? "Não informado"
                                                : Model.CpfCnpj)

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        E-mail
                    </label>

                    <div class="form-control bg-light">

                        @(string.IsNullOrWhiteSpace(Model.Email)
                                                ? "Não informado"
                                                : Model.Email)

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        Telefone
                    </label>

                    <div class="form-control bg-light">

                        @(string.IsNullOrWhiteSpace(Model.Telefone)
                                                ? "Não informado"
                                                : Model.Telefone)

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        Cidade
                    </label>

                    <div class="form-control bg-light">

                        @(string.IsNullOrWhiteSpace(Model.Cidade)
                                                ? "Não informado"
                                                : Model.Cidade)

                    </div>

                </div>

            </div>


            <!-- FORMULÁRIO DE EXCLUSÃO -->

            <form asp-action="Delete"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Confirmar Exclusão

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>