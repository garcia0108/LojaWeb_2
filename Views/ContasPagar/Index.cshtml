@model IEnumerable<LojaWeb_2.Models.ContaPagar>

@{
    ViewData["Title"] = "Contas a Pagar";
}

<div class="container-fluid mt-4 mb-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-arrow-up-right-circle me-2"></i>

                Contas a Pagar

            </h2>

            <p class="text-muted mb-0">
                Controle das obrigações e despesas da loja.
            </p>

        </div>


        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="Financeiro"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Financeiro

            </a>


            <a asp-action="Create"
               class="btn btn-success">

                <i class="bi bi-plus-circle me-1"></i>

                Nova conta

            </a>

        </div>

    </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert"
             id="alertSucesso">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>

        </div>
    }


    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert"
             id="alertErro">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Erro"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>

        </div>
    }


    <!-- FILTROS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-5">

                    <label class="form-label fw-semibold">
                        Pesquisa
                    </label>

                    <input type="text"
                           name="pesquisa"
                           value="@ViewBag.Pesquisa"
                           class="form-control"
                           placeholder="Descrição, categoria ou fornecedor..." />

                </div>


                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @if (ViewBag.Status?.ToString() == "Pendente")
                        {
                            <option value="Pendente" selected>
                                Pendente
                            </option>
                        }
                        else
                        {
                            <option value="Pendente">
                                Pendente
                            </option>
                        }


                        @if (ViewBag.Status?.ToString() == "Pago")
                        {
                            <option value="Pago" selected>
                                Pago
                            </option>
                        }
                        else
                        {
                            <option value="Pago">
                                Pago
                            </option>
                        }


                        @if (ViewBag.Status?.ToString() == "Cancelado")
                        {
                            <option value="Cancelado" selected>
                                Cancelado
                            </option>
                        }
                        else
                        {
                            <option value="Cancelado">
                                Cancelado
                            </option>
                        }

                    </select>

                </div>


                <div class="col-md-3">

                    <div class="d-flex gap-2 flex-wrap">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Pesquisar

                        </button>


                        @if (!string.IsNullOrWhiteSpace(
                                                ViewBag.Pesquisa as string)
                                                || ViewBag.Status != null)
                        {
                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Limpar

                            </a>
                        }

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- RESUMO -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Total de contas
                    </small>

                    <h4 class="fw-bold mt-1">

                        @Model.Count()

                    </h4>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Total pendente
                    </small>

                    <h4 class="fw-bold text-danger mt-1">

                        @(Model
                                                .Where(c =>
                                                c.Status ==
                                                StatusContaPagar.Pendente)
                                                .Sum(c => c.Valor)
                                                .ToString("C"))

                    </h4>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Total pago
                    </small>

                    <h4 class="fw-bold text-success mt-1">

                        @(Model
                                                .Where(c =>
                                                c.Status ==
                                                StatusContaPagar.Pago)
                                                .Sum(c => c.Valor)
                                                .ToString("C"))

                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- TABELA -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Descrição
                                </th>

                                <th>
                                    Fornecedor
                                </th>

                                <th>
                                    Categoria
                                </th>

                                <th>
                                    Vencimento
                                </th>

                                <th>
                                    Valor
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end"
                                    style="width: 1%; white-space: nowrap;">

                                    Ações

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var conta in Model)
                            {
                                <tr>

                                    <!-- DESCRIÇÃO -->

                                    <td>

                                        <strong>
                                            @conta.Descricao
                                        </strong>

                                    </td>


                                    <!-- FORNECEDOR -->

                                    <td>

                                        @if (conta.Fornecedor != null)
                                        {
                                            @conta.Fornecedor.Nome
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }

                                    </td>


                                    <!-- CATEGORIA -->

                                    <td>

                                        @conta.Categoria

                                    </td>


                                    <!-- VENCIMENTO -->

                                    <td>

                                        @conta.DataVencimento.ToString("dd/MM/yyyy")
                                       

                                        @if (
                                                                        conta.Status ==
                                                                        StatusContaPagar.Pendente &&
                                                                        conta.DataVencimento.Date <
                                                                        DateTime.Today)
                                        {
                                            <span class="badge bg-danger ms-1">
                                                Vencida
                                            </span>
                                        }

                                    </td>


                                    <!-- VALOR -->

                                    <td class="fw-semibold">

                                        @conta.Valor.ToString("C")

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (conta.Status ==
                                                                        StatusContaPagar.Pendente)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pendente
                                            </span>
                                        }
                                        else if (
                                        conta.Status ==
                                        StatusContaPagar.Pago)
                                        {
                                            <span class="badge bg-success">
                                                Pago
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelado
                                            </span>
                                        }

                                    </td>


                                    <!-- AÇÕES -->

                                    <td class="text-end"
                                        style="white-space: nowrap;">

                                        <div class="d-flex justify-content-end align-items-center gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@conta.Id"
                                               class="btn btn-outline-info btn-sm"
                                               title="Detalhes">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (
                                                                                conta.Status ==
                                                                                StatusContaPagar.Pendente)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@conta.Id"
                                                   class="btn btn-outline-primary btn-sm"
                                                   title="Editar">

                                                    <i class="bi bi-pencil"></i>

                                                </a>


                                                <form asp-action="Pagar"
                                                      asp-route-id="@conta.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-outline-success btn-sm"
                                                            title="Pagar"
                                                            onclick="return confirm('Confirmar pagamento desta conta?');">

                                                        <i class="bi bi-check-circle"></i>

                                                    </button>

                                                </form>


                                                <form asp-action="Cancelar"
                                                      asp-route-id="@conta.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm"
                                                            title="Cancelar"
                                                            onclick="return confirm('Cancelar esta conta a pagar?');">

                                                        <i class="bi bi-x-circle"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-wallet2 fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhuma conta a pagar encontrada.
                    </h5>

                    <p class="text-muted mb-0">
                        Cadastre uma conta para começar o controle financeiro.
                    </p>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {

    <script>

        setTimeout(function () {

            var alertSucesso =
                document.getElementById("alertSucesso");

            var alertErro =
                document.getElementById("alertErro");


            if (alertSucesso) {

                alertSucesso.classList.remove("show");

                setTimeout(function () {
                    alertSucesso.remove();
                }, 500);

            }


            if (alertErro) {

                alertErro.classList.remove("show");

                setTimeout(function () {
                    alertErro.remove();
                }, 500);

            }

        }, 4000);

    </script>
}